<% thread_counts = local_assigns.fetch(:thread_counts, nil) %>
<% if issues.any? %>
  <div class="space-y-1">
    <% issues.each do |issue| %>
      <% issue_thread = thread_counts && thread_counts[issue.id] %>
      <div class="relative" data-controller="issue-card" data-issue-id="<%= issue.id %>"
           data-current-lane-id="<%= issue.lane_id || 0 %>"
           data-current-label-ids="<%= issue.labels.map(&:id).to_json %>"
           data-issue-identifier="<%= issue.identifier %>"
           data-issue-title="<%= issue.title.truncate(30) %>">
        <%= link_to team_issue_path(team, issue),
            data: {
              turbo_frame: "_top",
              action: "mouseenter->issue-card#mouseEnter mouseleave->issue-card#mouseLeave"
            },
            class: "flex items-center gap-4 px-3 py-2.5 rounded-md hover:bg-hover-highlight transition-colors" do %>
          <span class="font-mono text-xs text-gray-500 w-20 shrink-0 inline-flex items-center gap-1.5">
            <%= issue.identifier %>
            <% if issue.blocking_dependencies.any? || issue.blocked_dependencies.any? %>
              <svg class="w-3 h-3 <%= issue.blocked_dependencies.any? ? 'text-red-400' : 'text-yellow-400' %>" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" title="<%= [issue.blocking_dependencies.any? ? "Blocking #{issue.blocking_dependencies.size}" : nil, issue.blocked_dependencies.any? ? "Blocked by #{issue.blocked_dependencies.size}" : nil].compact.join(' · ') %>">
                <path stroke-linecap="round" stroke-linejoin="round" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"></path>
              </svg>
            <% end %>
          </span>
          <span class="text-sm text-gray-200 flex-1 truncate"><%= issue.title %></span>
          <% if issue_thread && issue_thread[:link_id] %>
            <span class="inline-flex items-center gap-0.5 text-xs text-gray-500 shrink-0" title="<%= pluralize(issue_thread[:total], 'thread message') %>">
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M7 8h10M7 12h6m-6 8l-3-3h13a3 3 0 003-3V7a3 3 0 00-3-3H7a3 3 0 00-3 3v13z"></path>
              </svg>
              <% if issue_thread[:total] > 0 %><%= issue_thread[:total] %><% end %>
            </span>
            <% if issue_thread[:unread] > 0 %>
              <span class="inline-flex items-center justify-center min-w-[1rem] h-4 px-1 rounded-full text-[10px] font-medium bg-accent text-gray-900 shrink-0" title="<%= pluralize(issue_thread[:unread], 'unread message') %>">
                <%= issue_thread[:unread] %>
              </span>
            <% end %>
          <% end %>
          <% if issue.lane %>
            <span class="text-xs text-gray-500"><%= issue.lane.name %></span>
          <% end %>
          <% if issue.assignee %>
            <span class="text-xs text-gray-400"><%= issue.assignee.name %></span>
          <% end %>
        <% end %>

        <%# Lane/Label pickers are rendered once on the project show page as shared
            overlays and retargeted at the hovered card, not per card. %>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="py-6 flex flex-col items-start gap-3">
    <p class="text-sm text-gray-500">No issues assigned to this project yet.</p>
    <%= link_to new_team_issue_path(team, project_id: project.id),
        data: { turbo_frame: "_top" },
        class: "inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded border border-stroke text-gray-300 hover:bg-hover-highlight hover:text-accent transition-colors" do %>
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"></path>
      </svg>
      <span>New issue</span>
    <% end %>
  </div>
<% end %>
