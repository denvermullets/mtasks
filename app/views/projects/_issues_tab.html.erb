<%# locals: (project:, team:, issues:, lanes:, labels:, sort:, filter:) %>
<%= render "projects/progress_chart", project: project %>

<div class="flex items-center justify-between mb-4">
  <h2 class="text-sm font-semibold text-gray-400">
    Issues
    <span class="text-gray-500 font-normal">(<%= issues.count %>)</span>
  </h2>
  <div class="flex items-center gap-1">
    <span class="text-xs text-gray-600 mr-1">Show:</span>
    <% { 'all' => 'All', 'active' => 'Active' }.each do |filter_option, label| %>
      <%= link_to label,
          team_project_path(team, project, sort: sort, filter: filter_option),
          class: "px-2 py-0.5 text-xs rounded cursor-pointer #{filter == filter_option ? 'bg-foreground border border-stroke text-gray-100' : 'text-gray-500 hover:text-gray-300'}" %>
    <% end %>
    <span class="text-xs text-gray-600 mx-1">Sort:</span>
    <% { 'newest' => 'Newest', 'id' => 'ID', 'status' => 'Status', 'updated' => 'Updated', 'priority' => 'Priority' }.each do |sort_option, label| %>
      <%= link_to label,
          team_project_path(team, project, sort: sort_option, filter: filter),
          class: "px-2 py-0.5 text-xs rounded cursor-pointer #{sort == sort_option ? 'bg-foreground border border-stroke text-gray-100' : 'text-gray-500 hover:text-gray-300'}" %>
    <% end %>
    <%= link_to new_team_issue_path(team, project_id: project.id),
        data: { turbo_frame: "_top" },
        class: "ml-2 p-1 rounded text-gray-500 hover:text-accent hover:bg-hover-highlight transition-colors",
        title: "New issue in this project",
        aria: { label: "New issue in this project" } do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"></path>
      </svg>
    <% end %>
  </div>
</div>

<div id="project_issues_list_<%= project.id %>">
  <%= render "projects/issues_list", project: project, issues: issues, team: team, lanes: lanes, labels: labels, thread_counts: @thread_counts %>
</div>
