<div class="flex h-screen bg-background">
  <!-- Main Content Area -->
  <div class="flex-1 flex flex-col overflow-hidden">
    <!-- Top Bar -->
    <div class="h-14 bg-menu border-b border-stroke flex items-center justify-between px-4 shrink-0">
      <div class="flex items-center gap-4">
        <%= link_to team_projects_path(@team),
            class: "text-sm text-gray-500 hover:text-gray-400 flex items-center gap-2" do %>
          <span>&#8592;</span>
          <span><%= @team.name %></span>
        <% end %>
        <span class="text-gray-600">&#8250;</span>
        <span class="text-sm text-gray-400">New project</span>
      </div>
    </div>

    <%= form_with model: [@team, @project], class: "flex-1 flex overflow-hidden" do |form| %>
      <!-- Left Content -->
      <div class="flex-1 overflow-y-auto p-8">
        <div class="max-w-3xl">
          <!-- Project Icon & Name -->
          <div class="flex items-start gap-4 mb-6">
            <div class="w-10 h-10 bg-accent/20 rounded flex items-center justify-center text-accent shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
              </svg>
            </div>
            <div class="flex-1">
              <%= form.text_field :name,
                  placeholder: "Project name",
                  autofocus: true,
                  required: true,
                  autocomplete: "off",
                  class: "w-full bg-transparent border-0 text-gray-200 text-2xl font-semibold placeholder-gray-600 focus:outline-none focus:ring-0 p-0" %>
            </div>
          </div>

          <!-- Description Section -->
          <div class="mb-8">
            <h3 class="text-sm font-medium text-gray-400 mb-3">Description</h3>
            <%= form.text_area :description,
                placeholder: "Add description...",
                rows: 6,
                autocomplete: "off",
                class: "w-full bg-transparent border-0 text-gray-300 placeholder-gray-600 focus:outline-none focus:ring-0 p-0 resize-none" %>
          </div>

          <% if @project.errors.any? %>
            <div class="bg-red-900/20 border border-red-500 rounded-md p-4 mb-6">
              <h3 class="text-sm font-medium text-red-400 mb-2">
                <%= pluralize(@project.errors.count, "error") %> prohibited this project from being saved:
              </h3>
              <ul class="list-disc list-inside text-sm text-red-300">
                <% @project.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Right Sidebar -->
      <div class="w-80 border-l border-stroke bg-menu overflow-y-auto p-6 shrink-0">
        <div class="space-y-6">
          <!-- Milestone -->
          <div>
            <div class="text-xs font-medium text-gray-500 mb-2">Milestone</div>
            <%= form.select :milestone_id,
                options_from_collection_for_select(@team.milestones, :id, :name, @project.milestone_id),
                { include_blank: "No milestone" },
                class: "w-full px-3 py-2 bg-background border border-stroke rounded-md text-gray-200 text-sm focus:outline-none focus:border-accent" %>
          </div>

          <!-- Future Properties (Placeholders) -->
          <div class="pt-6 border-t border-stroke">
            <div class="text-xs font-medium text-gray-500 mb-3">Future Properties</div>
            <div class="space-y-3 text-xs text-gray-600">
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <span>Status</span>
              </div>
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                </svg>
                <span>Priority</span>
              </div>
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                </svg>
                <span>Lead & Members</span>
              </div>
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                </svg>
                <span>Dates</span>
              </div>
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
                </svg>
                <span>Labels</span>
              </div>
            </div>
            <p class="text-xs text-gray-600 mt-4 italic">Additional properties can be added as the model expands</p>
          </div>

          <!-- Actions -->
          <div class="pt-6 border-t border-stroke space-y-3">
            <%= form.submit "Create Project",
                class: "w-full px-4 py-2 bg-accent text-white rounded-md hover:bg-accent-hover transition-colors font-medium text-sm" %>
            <%= link_to "Cancel",
                team_projects_path(@team),
                class: "block w-full px-4 py-2 text-center text-gray-400 hover:text-gray-200 transition-colors text-sm" %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
