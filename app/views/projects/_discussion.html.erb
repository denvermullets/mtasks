<%# locals: (project:, channel_link:, team:, thread_id: nil) %>
<% if channel_link.nil? %>
  <div class="border border-dashed border-stroke rounded-lg py-16 px-6 text-center">
    <div class="w-10 h-10 rounded-full bg-foreground border border-stroke mx-auto mb-4 flex items-center justify-center text-gray-500">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M7 8h10M7 12h6m-3 9l-4-4H5a2 2 0 01-2-2V5a2 2 0 012-2h14a2 2 0 012 2v10a2 2 0 01-2 2h-3l-4 4z"/>
      </svg>
    </div>
    <h3 class="text-sm font-medium text-gray-200 mb-1">No channel linked yet</h3>
    <p class="text-xs text-gray-500 mb-6 max-w-sm mx-auto">
      Link a Hourglass channel to bring discussion, decisions, and channel context into this project.
    </p>
    <%= link_to new_team_project_hourglass_channel_link_path(team, project),
        data: { turbo_frame: "hourglass_channel_link_modal" },
        class: "inline-flex items-center gap-1.5 px-3 py-1.5 rounded bg-accent/10 border border-accent/30 text-accent text-xs font-medium hover:bg-accent/20 transition-colors" do %>
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/>
      </svg>
      Link a Hourglass channel
    <% end %>
  </div>
<% elsif channel_link.broken? %>
  <div class="border border-red-500/30 bg-red-500/5 rounded-lg p-6">
    <div class="flex items-start gap-3">
      <svg class="w-5 h-5 text-red-400 mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
      </svg>
      <div class="flex-1">
        <h3 class="text-sm font-medium text-red-200 mb-1">Channel link is broken</h3>
        <p class="text-xs text-red-300/80 mb-4">
          We couldn't reach <span class="font-mono">#<%= channel_link.hourglass_channel_name.presence || channel_link.hourglass_channel_id %></span> on Hourglass.
          The channel may have been deleted or the integration token revoked.
        </p>
        <div class="flex items-center gap-2">
          <%= link_to new_team_project_hourglass_channel_link_path(team, project),
              data: { turbo_frame: "hourglass_channel_link_modal" },
              class: "px-2.5 py-1 rounded bg-red-500/20 border border-red-500/40 text-red-200 text-xs font-medium hover:bg-red-500/30 transition-colors" do %>
            Re-link channel
          <% end %>
          <%= button_to team_project_hourglass_channel_link_path(team, project),
              method: :delete,
              data: { turbo_frame: "_top" },
              class: "px-2.5 py-1 rounded border border-stroke text-gray-400 text-xs hover:text-gray-200 hover:bg-hover-highlight transition-colors" do %>
            Unlink
          <% end %>
        </div>
      </div>
    </div>
  </div>
<% else %>
  <% thread_id = thread_id.presence if thread_id %>
  <div class="border border-stroke rounded-lg overflow-hidden" data-controller="discussion-filter">
    <div class="flex items-center justify-between px-4 py-3 border-b border-stroke bg-foreground">
      <div class="flex items-center gap-2 min-w-0">
        <% if thread_id %>
          <%= link_to discussion_team_project_path(team, project),
              class: "inline-flex items-center gap-1.5 text-xs text-gray-400 hover:text-gray-200" do %>
            <span aria-hidden="true">&larr;</span>
            <span>back to</span>
            <span class="font-medium text-gray-200">#<%= channel_link.hourglass_channel_name.presence || channel_link.hourglass_channel_id %></span>
          <% end %>
        <% else %>
          <svg class="w-4 h-4 text-gray-500 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5.5 8.5h13M5.5 15.5h13M9 4l-2 16M17 4l-2 16"/>
          </svg>
          <span class="text-sm font-medium text-gray-100 truncate">
            <%= channel_link.hourglass_channel_name.presence || channel_link.hourglass_channel_id %>
          </span>
        <% end %>
        <span class="text-xs text-gray-500 truncate"><% if thread_id %>&middot; thread <span class="font-mono"><%= thread_id %></span><% else %>&middot; project channel<% end %></span>
      </div>
      <% unless thread_id %>
        <%= button_to team_project_hourglass_channel_link_path(team, project),
            method: :delete,
            form: { data: { turbo_confirm: 'Unlink this channel from the project?' } },
            class: "px-2 py-1 rounded text-xs text-gray-500 hover:text-gray-200 hover:bg-hover-highlight transition-colors" do %>
          Unlink
        <% end %>
      <% end %>
    </div>
    <% unless thread_id %>
      <%= render 'projects/decisions_card', project: project %>
    <% end %>
    <div id="discussion-flash" class="px-4 pt-3"></div>
    <%= turbo_stream_from "project_#{project.id}_discussion" %>
    <div id="discussion-stream"
         data-discussion-filter-target="stream"
         class="divide-y divide-stroke/40 [&:has(article)>#discussion-empty-state]:hidden">
      <% if thread_id %>
        <% messages = HourglassMessageCache
                        .where(hourglass_channel_id: channel_link.hourglass_channel_id)
                        .where('hourglass_thread_id = :tid OR hourglass_message_id = :tid', tid: thread_id)
                        .not_deleted
                        .order(:posted_at) %>
        <div id="discussion-empty-state" class="px-4 py-10 text-center text-xs text-gray-500 <%= 'hidden' if messages.any? %>">
          No messages cached for this thread yet.
        </div>
        <% messages.each do |message| %>
          <%= render "projects/discussion_message", message: message, team: team, channel_link: channel_link %>
        <% end %>
      <% else %>
        <% items = DiscussionStreamService.call(project: project, channel_link: channel_link) %>
        <%= render "projects/discussion_empty_state", channel_link: channel_link, hidden: items.any? %>
        <% items.each do |item| %>
          <% if item.kind == :hourglass %>
            <%= render "projects/discussion_message", message: item.record, project: project, channel_link: channel_link %>
          <% else %>
            <%= render "projects/discussion_native_comment", comment: item.record, project: project %>
          <% end %>
        <% end %>
      <% end %>
    </div>
    <% unless thread_id %>
      <%= render "discussion/comments/composer",
                 team: team,
                 form_url: team_project_discussion_comments_path(team, project) %>
    <% end %>
  </div>
<% end %>
