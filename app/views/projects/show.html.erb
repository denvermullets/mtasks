<div class="flex h-screen bg-background">
  <div class="flex-1 flex flex-col overflow-hidden">
    <!-- Top Bar -->
    <div class="h-14 bg-menu border-b border-stroke flex items-center justify-between px-4 shrink-0">
      <div class="flex items-center gap-4">
        <%= link_to team_projects_path(@team),
            class: "text-sm text-gray-500 hover:text-gray-400 flex items-center gap-2" do %>
          <span>&#8592;</span>
          <span><%= @team.name %></span>
        <% end %>
        <span class="text-gray-600">&#8250;</span>
        <span class="text-sm text-gray-400"><%= @project.name %></span>
      </div>
      <div class="flex items-center gap-2">
        <%= link_to "Edit", edit_team_project_path(@team, @project),
            class: "px-3 py-1.5 text-xs font-medium rounded bg-gray-800 text-gray-300 hover:bg-gray-700" %>
      </div>
    </div>

    <div class="flex-1 flex overflow-hidden">
      <!-- Main Content -->
      <div class="flex-1 overflow-y-auto p-8">
        <div class="max-w-3xl">
          <!-- Project Header -->
          <div class="flex items-start gap-4 mb-6">
            <div class="w-10 h-10 bg-accent/20 rounded flex items-center justify-center text-accent shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
              </svg>
            </div>
            <div class="flex-1">
              <h1 class="text-2xl font-semibold text-gray-100"><%= @project.name %></h1>
            </div>
          </div>

          <!-- Description -->
          <% if @project.description.present? %>
            <div class="mb-8">
              <div class="text-gray-300 prose prose-invert max-w-none">
                <%= simple_format(@project.description) %>
              </div>
            </div>
          <% end %>

          <!-- Attachments -->
          <% if @project.files.attached? %>
            <div class="mb-8">
              <h2 class="text-sm font-semibold text-gray-400 mb-4">Attachments</h2>

              <!-- Image attachments -->
              <% images = @project.files.select(&:image?) %>
              <% if images.any? %>
                <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 mb-4">
                  <% images.each do |file| %>
                    <%= link_to url_for(file), target: "_blank", class: "block" do %>
                      <div class="aspect-video bg-foreground border border-stroke rounded-md overflow-hidden hover:border-accent/50 transition-colors">
                        <%= image_tag url_for(file), class: "w-full h-full object-cover", alt: file.filename %>
                      </div>
                      <p class="text-xs text-gray-500 mt-1 truncate"><%= file.filename %></p>
                    <% end %>
                  <% end %>
                </div>
              <% end %>

              <!-- Non-image attachments -->
              <% other_files = @project.files.reject(&:image?) %>
              <% if other_files.any? %>
                <div class="space-y-2">
                  <% other_files.each do |file| %>
                    <div class="flex items-center justify-between px-3 py-2 bg-foreground border border-stroke rounded-md text-sm">
                      <div class="flex items-center gap-2 text-gray-300 min-w-0">
                        <% if file.content_type == "application/pdf" %>
                          <span class="text-gray-500 shrink-0">&#128196;</span>
                        <% else %>
                          <span class="text-gray-500 shrink-0">&#128206;</span>
                        <% end %>
                        <span class="truncate"><%= file.filename %></span>
                        <span class="text-gray-500 shrink-0"><%= number_to_human_size(file.byte_size) %></span>
                      </div>
                      <%= link_to "Download", rails_blob_path(file, disposition: "attachment"),
                          class: "text-accent hover:text-accent-hover text-xs shrink-0 ml-2" %>
                    </div>
                  <% end %>
                </div>
              <% end %>
            </div>
          <% end %>

          <!-- Issues Section -->
          <div class="border-t border-stroke pt-8">
            <div class="flex items-center justify-between mb-4">
              <h2 class="text-sm font-semibold text-gray-400">
                Issues
                <span class="text-gray-500 font-normal">(<%= @issues.count %>)</span>
              </h2>
            </div>

            <% if @issues.any? %>
              <div class="space-y-1">
                <% @issues.each do |issue| %>
                  <%= link_to team_issue_path(@team, issue),
                      class: "flex items-center gap-4 px-3 py-2.5 rounded-md hover:bg-hover-highlight transition-colors" do %>
                    <span class="font-mono text-xs text-gray-500 w-20 shrink-0"><%= issue.identifier %></span>
                    <span class="text-sm text-gray-200 flex-1 truncate"><%= issue.title %></span>
                    <% if issue.lane %>
                      <span class="text-xs text-gray-500"><%= issue.lane.name %></span>
                    <% end %>
                    <% if issue.assignee %>
                      <span class="text-xs text-gray-400"><%= issue.assignee.name %></span>
                    <% end %>
                  <% end %>
                <% end %>
              </div>
            <% else %>
              <p class="text-sm text-gray-500 py-4">No issues assigned to this project yet.</p>
            <% end %>
          </div>
        </div>
      </div>

      <!-- Right Sidebar -->
      <div class="w-80 border-l border-stroke bg-menu overflow-y-auto p-6 shrink-0 hidden sm:block">
        <div class="space-y-6">
          <!-- Milestone -->
          <div>
            <div class="text-xs font-medium text-gray-500 mb-2">Milestone</div>
            <% if @project.milestone %>
              <div class="flex items-center gap-2 text-sm text-gray-300">
                <span style="color: <%= @project.milestone.status_color %>;">&#9670;</span>
                <span><%= @project.milestone.name %></span>
              </div>
              <% if @project.milestone.due_date %>
                <div class="text-xs text-gray-500 mt-1"><%= @project.milestone.formatted_due_date %></div>
              <% end %>
            <% else %>
              <div class="text-sm text-gray-500">No milestone</div>
            <% end %>
          </div>

          <!-- Stats -->
          <div class="pt-6 border-t border-stroke">
            <div class="text-xs font-medium text-gray-500 mb-3">Details</div>
            <div class="space-y-3 text-sm">
              <div class="flex items-center justify-between">
                <span class="text-gray-500">Issues</span>
                <span class="text-gray-300"><%= @issues.count %></span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-gray-500">Created</span>
                <span class="text-gray-300"><%= @project.created_at.strftime('%b %d, %Y') %></span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-gray-500">Updated</span>
                <span class="text-gray-300"><%= @project.updated_at.strftime('%b %d, %Y') %></span>
              </div>
              <% if @project.files.attached? %>
                <div class="flex items-center justify-between">
                  <span class="text-gray-500">Attachments</span>
                  <span class="text-gray-300"><%= @project.files.count %></span>
                </div>
              <% end %>
            </div>
          </div>

          <!-- Actions -->
          <div class="pt-6 border-t border-stroke space-y-3">
            <%= link_to "Edit Project", edit_team_project_path(@team, @project),
                class: "block w-full px-4 py-2 text-center border border-accent text-gray-200 hover:bg-accent hover:text-gray-800 font-medium cursor-pointer rounded-md text-sm" %>
            <%= button_to "Delete Project", team_project_path(@team, @project),
                method: :delete,
                class: "w-full px-4 py-2 text-center text-red-400 hover:text-red-300 transition-colors text-sm",
                data: { turbo_confirm: "Are you sure you want to delete this project? Issues will be unlinked but not deleted." } %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
