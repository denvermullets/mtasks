<div class="flex flex-1 min-h-0 bg-background" data-controller="properties-drawer lightbox">
  <div class="flex-1 flex flex-col overflow-hidden">
    <!-- Top Bar -->
    <div class="h-14 bg-menu border-b border-stroke flex items-center justify-between px-4 shrink-0">
      <div class="flex items-center gap-4">
        <%= render "shared/mobile_menu_button" %>
        <%= link_to team_projects_path(@team),
            class: "text-sm text-gray-500 hover:text-gray-400 flex items-center gap-2" do %>
          <span>&#8592;</span>
          <span class="hidden sm:inline"><%= @team.name %></span>
          <span class="sm:hidden">Back</span>
        <% end %>
        <span class="text-gray-600">&#8250;</span>
        <span class="text-sm text-gray-400 truncate"><%= @project.name %></span>
      </div>
      <div class="flex items-center gap-2">
        <!-- Mobile Properties Button -->
        <button type="button"
                class="sm:hidden p-2 text-gray-400 hover:text-gray-200 rounded-md hover:bg-gray-800"
                data-action="click->properties-drawer#toggle"
                aria-label="Open properties">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"></path>
          </svg>
        </button>
        <%= link_to "Edit", edit_team_project_path(@team, @project),
            class: "px-3 py-1.5 text-xs font-medium rounded bg-gray-800 text-gray-300 hover:bg-gray-700" %>
      </div>
    </div>

    <div class="flex-1 flex overflow-hidden">
      <!-- Main Content -->
      <div class="flex-1 overflow-y-auto p-8">
        <div class="max-w-3xl">
          <!-- Project Header -->
          <div class="flex items-start gap-4 mb-6">
            <div class="w-10 h-10 bg-accent/20 rounded flex items-center justify-center text-accent shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
              </svg>
            </div>
            <div class="flex-1">
              <h1 class="text-2xl font-semibold text-gray-100"><%= @project.name %></h1>
            </div>
          </div>

          <!-- Description -->
          <% if @project.description.present? %>
            <div class="mb-8">
              <div class="text-gray-300 prose prose-invert max-w-none">
                <%= simple_format(@project.description) %>
              </div>
            </div>
          <% end %>

          <!-- Attachments -->
          <% if @project.files.attached? %>
            <div class="mb-8">
              <h2 class="text-sm font-semibold text-gray-400 mb-4">Attachments</h2>
              <%= render "shared/attachments", files: @project.files %>
            </div>
          <% end %>

          <!-- Issues Section -->
          <div class="border-t border-stroke pt-8">
            <% if @project.total_issues_count > 0 %>
              <!-- Progress Chart -->
              <div class="mb-6"
                   data-controller="progress-chart"
                   data-progress-chart-data-value="<%= @project.progress_chart_data.to_json %>"
                   data-progress-chart-expected-value="<%= (@project.expected_progress_line || []).to_json %>"
                   data-progress-chart-behind-schedule-value="<%= @project.behind_schedule? %>">
              </div>
            <% end %>

            <div class="flex items-center justify-between mb-4">
              <h2 class="text-sm font-semibold text-gray-400">
                Issues
                <span class="text-gray-500 font-normal">(<%= @issues.count %>)</span>
              </h2>
              <div class="flex items-center gap-1">
                <span class="text-xs text-gray-600 mr-1">Sort:</span>
                <% %w[newest status updated priority].each do |sort_option| %>
                  <%= link_to sort_option.capitalize,
                      team_project_path(@team, @project, sort: sort_option),
                      class: "px-2 py-0.5 text-xs rounded #{@sort == sort_option ? 'bg-foreground border border-stroke text-gray-100' : 'text-gray-500 hover:text-gray-300'}" %>
                <% end %>
              </div>
            </div>

            <% if @issues.any? %>
              <div class="space-y-1">
                <% @issues.each do |issue| %>
                  <%= link_to team_issue_path(@team, issue),
                      class: "flex items-center gap-4 px-3 py-2.5 rounded-md hover:bg-hover-highlight transition-colors" do %>
                    <span class="font-mono text-xs text-gray-500 w-20 shrink-0 inline-flex items-center gap-1.5">
                      <%= issue.identifier %>
                      <% if issue.blocking_dependencies.any? || issue.blocked_dependencies.any? %>
                        <svg class="w-3 h-3 <%= issue.blocked_dependencies.any? ? 'text-red-400' : 'text-yellow-400' %>" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" title="<%= [issue.blocking_dependencies.any? ? "Blocking #{issue.blocking_dependencies.size}" : nil, issue.blocked_dependencies.any? ? "Blocked by #{issue.blocked_dependencies.size}" : nil].compact.join(' · ') %>">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"></path>
                        </svg>
                      <% end %>
                    </span>
                    <span class="text-sm text-gray-200 flex-1 truncate"><%= issue.title %></span>
                    <% if issue.lane %>
                      <span class="text-xs text-gray-500"><%= issue.lane.name %></span>
                    <% end %>
                    <% if issue.assignee %>
                      <span class="text-xs text-gray-400"><%= issue.assignee.name %></span>
                    <% end %>
                  <% end %>
                <% end %>
              </div>
            <% else %>
              <p class="text-sm text-gray-500 py-4">No issues assigned to this project yet.</p>
            <% end %>
          </div>
        </div>
      </div>

      <!-- Right Sidebar - Properties -->
      <div class="hidden sm:block">
        <%= render 'sidebar', project: @project, lanes: @lanes, team_members: @team_members, labels: @labels, milestones: @milestones %>
      </div>
    </div>
  </div>
  <!-- Mobile Properties Drawer -->
  <div data-properties-drawer-target="drawer" class="fixed inset-0 z-50 hidden sm:hidden">
    <!-- Overlay -->
    <div class="absolute inset-0 bg-black/50" data-action="click->properties-drawer#close"></div>
    <!-- Drawer panel (slides in from right, full width) -->
    <div data-properties-drawer-target="panel" class="absolute inset-y-0 right-0 w-full bg-menu flex flex-col transform translate-x-full transition-transform duration-200 ease-in-out">
      <!-- Header with close button -->
      <div class="h-14 border-b border-stroke flex items-center justify-between px-4 shrink-0">
        <span class="text-sm font-medium text-gray-300">Properties</span>
        <button type="button" class="p-1 text-gray-400 hover:text-gray-200" data-action="click->properties-drawer#close">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
      <!-- Sidebar content -->
      <div class="flex-1 overflow-y-auto">
        <%= render 'sidebar', project: @project, lanes: @lanes, team_members: @team_members, labels: @labels, milestones: @milestones, mobile: true %>
      </div>
    </div>
  </div>

  <%= render "shared/lightbox" %>
</div>
