<%= turbo_stream_from "project_#{@project.id}" %>
<div class="flex flex-1 min-h-0 bg-background" data-controller="properties-drawer lightbox board-keyboard">
  <div class="flex-1 flex flex-col overflow-hidden">
    <!-- Top Bar -->
    <div class="h-14 bg-menu border-b border-stroke flex items-center justify-between px-4 shrink-0">
      <div class="flex items-center gap-4">
        <%= render "shared/mobile_menu_button" %>
        <% back = back_nav_link(fallback_url: team_projects_path(@team), fallback_label: 'Projects') %>
        <%= link_to back[:url],
            class: "text-sm text-gray-500 hover:text-gray-400 flex items-center gap-2" do %>
          <span>&#8592;</span>
          <span class="hidden sm:inline"><%= back[:label] %></span>
          <span class="sm:hidden">Back</span>
        <% end %>
        <span class="text-gray-600">&#8250;</span>
        <span class="text-sm text-gray-400 truncate"><%= @project.name %></span>
        <%= render "channel_link_badge", project: @project %>
      </div>
      <div class="flex items-center gap-2">
        <!-- Mobile Properties Button -->
        <button type="button"
                class="sm:hidden p-2 text-gray-400 hover:text-gray-200 rounded-md hover:bg-gray-800"
                data-action="click->properties-drawer#toggle"
                aria-label="Open properties">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"></path>
          </svg>
        </button>
        <%= link_to "Edit", edit_team_project_path(@team, @project),
            class: "px-3 py-1.5 text-xs font-medium rounded bg-gray-800 text-gray-300 hover:bg-gray-700" %>
      </div>
    </div>

    <div class="flex-1 flex overflow-hidden">
      <!-- Main Content -->
      <div class="flex-1 overflow-y-auto p-8">
        <div class="max-w-3xl">
          <!-- Project Header -->
          <div class="flex items-start gap-4 mb-6">
            <div class="w-10 h-10 bg-accent/20 rounded flex items-center justify-center text-accent shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
              </svg>
            </div>
            <div class="flex-1">
              <h1 class="text-2xl font-semibold text-gray-100"><%= @project.name %></h1>
            </div>
          </div>

          <%= render "tab_nav", project: @project, team: @team, active_tab: @active_tab || :issues %>

          <% case @active_tab %>
          <% when :overview %>
            <%= turbo_frame_tag "project_tab_overview" do %>
              <%= render "overview", project: @project %>
            <% end %>
          <% when :discussion %>
            <%= turbo_frame_tag "project_tab_discussion" do %>
              <%= render "discussion", project: @project, channel_link: @channel_link, team: @team %>
            <% end %>
          <% when :activity %>
            <%= turbo_frame_tag "project_tab_activity" do %>
              <%= render "activity", project: @project %>
            <% end %>
          <% else %>
            <%= turbo_frame_tag "project_tab_issues" do %>
              <%= render "issues_tab", project: @project, team: @team, issues: @issues, lanes: @lanes, labels: @labels, sort: @sort %>
            <% end %>
          <% end %>
        </div>
      </div>

      <!-- Right Sidebar - Properties -->
      <div class="hidden sm:block">
        <%= render 'sidebar', project: @project, lanes: @lanes, team_members: @team_members, labels: @labels %>
      </div>
    </div>
  </div>
  <!-- Mobile Properties Drawer -->
  <div data-properties-drawer-target="drawer" class="fixed inset-0 z-50 hidden sm:hidden">
    <!-- Overlay -->
    <div class="absolute inset-0 bg-black/50" data-action="click->properties-drawer#close"></div>
    <!-- Drawer panel (slides in from right, full width) -->
    <div data-properties-drawer-target="panel" class="absolute inset-y-0 right-0 w-full bg-menu flex flex-col transform translate-x-full transition-transform duration-200 ease-in-out">
      <!-- Header with close button -->
      <div class="h-14 border-b border-stroke flex items-center justify-between px-4 shrink-0">
        <span class="text-sm font-medium text-gray-300">Properties</span>
        <button type="button" class="p-1 text-gray-400 hover:text-gray-200" data-action="click->properties-drawer#close">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
      <!-- Sidebar content -->
      <div class="flex-1 overflow-y-auto">
        <%= render 'sidebar', project: @project, lanes: @lanes, team_members: @team_members, labels: @labels, mobile: true %>
      </div>
    </div>
  </div>

  <%= render "shared/lightbox" %>
  <%= turbo_frame_tag "hourglass_channel_link_modal" %>
</div>
