<div class="flex-1 flex flex-col min-h-0">
  <!-- Top Bar -->
  <div class="h-14 bg-menu border-b border-stroke flex items-center justify-between px-4 shrink-0">
    <div class="flex items-center gap-4">
      <%= render "shared/mobile_menu_button" %>
      <%= link_to team_issues_path(current_team),
          class: "text-sm text-gray-500 hover:text-gray-400 flex items-center gap-2" do %>
        <span>&#8592;</span>
        <span class="hidden sm:inline"><%= current_team.name %></span>
        <span class="sm:hidden">Back</span>
      <% end %>
      <span class="text-gray-600">&#8250;</span>
      <span class="text-sm text-gray-400">Projects</span>
    </div>
    <div class="flex items-center gap-2">
      <%= link_to "New Project",
          new_team_project_path(current_team),
          class: "px-3 py-1.5 text-xs font-medium rounded bg-gray-800 text-gray-300 hover:bg-gray-700" %>
    </div>
  </div>

  <div class="flex-1 overflow-y-auto p-6">
    <% if @projects.any? %>
      <div class="space-y-3">
        <% @projects.each do |project| %>
          <div class="bg-foreground border border-stroke rounded-md p-4 hover:bg-hover-highlight transition-colors">
            <%= link_to team_project_path(current_team, project), class: "block" do %>
              <div class="flex items-start justify-between">
                <div class="flex-1">
                  <h3 class="text-base font-medium text-gray-200 mb-1"><%= project.name %></h3>
                  <% if project.description.present? %>
                    <p class="text-sm text-gray-400 line-clamp-2"><%= project.description %></p>
                  <% end %>
                  <div class="flex items-center gap-4 mt-2 text-xs text-gray-500">
                    <span><%= pluralize(project.issues.count, 'issue') %></span>
                    <% if project.milestone %>
                      <span>• <%= project.milestone.name %></span>
                    <% end %>
                    <span>• Created <%= project.created_at.strftime('%b %d, %Y') %></span>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-12">
        <p class="text-gray-400 mb-4">No projects yet</p>
        <%= link_to "Create your first project",
            new_team_project_path(current_team),
            class: "inline-block px-4 py-2 border border-accent text-gray-200 hover:bg-accent hover:text-gray-800 font-medium cursor-pointer rounded-md" %>
      </div>
    <% end %>
  </div>
</div>
