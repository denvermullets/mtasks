<div class="flex-1 flex flex-col min-h-0">
  <!-- Top Bar -->
  <div class="h-14 bg-menu border-b border-stroke flex items-center justify-between px-4 shrink-0">
    <div class="flex items-center gap-4">
      <h1 class="text-base font-semibold">GitHub Integration</h1>
      <span class="text-sm text-gray-500"><%= @workspace.name %> (Workspace)</span>
    </div>
    <%= link_to "Back to Workspace", workspace_path(@workspace), class: "text-sm text-gray-400 hover:text-gray-300" %>
  </div>

  <!-- Integration Content -->
  <div class="flex-1 overflow-y-auto bg-background p-8">
    <div class="max-w-4xl mx-auto w-full space-y-6">
      <!-- Connection Status -->
      <div class="bg-foreground border border-stroke rounded-lg p-6">
        <h2 class="text-lg font-semibold text-gray-200 mb-4">Workspace Installation Status</h2>

        <% if @installation&.active? %>
          <!-- Connected State -->
          <div class="space-y-4">
            <div class="flex items-center gap-2">
              <div class="w-2 h-2 bg-green-500 rounded-full"></div>
              <span class="text-green-400 font-medium">Connected</span>
            </div>

            <div class="space-y-2 text-sm">
              <div class="flex justify-between py-2 border-b border-stroke">
                <span class="text-gray-400">GitHub Account:</span>
                <span class="text-gray-200 font-mono"><%= @installation.github_account_login %></span>
              </div>

              <div class="flex justify-between py-2 border-b border-stroke">
                <span class="text-gray-400">Account Type:</span>
                <span class="text-gray-200"><%= @installation.github_account_type %></span>
              </div>

              <% if @installation.last_webhook_at %>
                <div class="flex justify-between py-2 border-b border-stroke">
                  <span class="text-gray-400">Last Webhook:</span>
                  <span class="text-gray-200"><%= time_ago_in_words(@installation.last_webhook_at) %> ago</span>
                </div>
              <% end %>
            </div>

            <%= button_to "Disconnect", workspace_github_installation_path(@workspace),
                method: :delete,
                data: { turbo_confirm: "Are you sure? This will disconnect GitHub for all teams in this workspace." },
                class: "mt-4 px-4 py-2 border border-red-500 text-red-400 hover:bg-red-500 hover:text-white font-medium cursor-pointer rounded-md" %>
          </div>
        <% else %>
          <!-- Disconnected State -->
          <div class="space-y-4">
            <div class="flex items-center gap-2">
              <div class="w-2 h-2 bg-gray-500 rounded-full"></div>
              <span class="text-gray-400 font-medium">Not Connected</span>
            </div>

            <p class="text-sm text-gray-400">
              Connect your workspace to GitHub to enable pull request tracking across all teams.
            </p>

            <%= link_to "Connect GitHub", new_workspace_github_installation_path(@workspace),
                class: "inline-block px-4 py-2 border border-accent text-gray-200 hover:bg-accent hover:text-gray-800 font-medium cursor-pointer rounded-md" %>
          </div>
        <% end %>
      </div>

      <!-- Team Subscriptions (if connected) -->
      <% if @installation&.active? %>
        <div class="bg-foreground border border-stroke rounded-lg p-6">
          <h2 class="text-lg font-semibold text-gray-200 mb-4">Team Repository Access</h2>

          <% subscriptions = @workspace.github_repository_subscriptions.active.includes(:team).group_by(&:team) %>

          <% if subscriptions.any? %>
            <div class="space-y-4">
              <% subscriptions.each do |team, team_subscriptions| %>
                <div class="border border-stroke rounded-lg p-4">
                  <div class="flex items-center justify-between mb-2">
                    <h3 class="font-semibold text-gray-200"><%= team.name %> (<%= team.identifier %>)</h3>
                    <%= link_to "Manage →", team_github_repositories_path(team), class: "text-sm text-accent hover:underline" %>
                  </div>
                  <div class="space-y-1">
                    <% team_subscriptions.each do |subscription| %>
                      <div class="text-sm text-gray-400 font-mono flex items-center gap-2">
                        <span class="w-1.5 h-1.5 bg-green-500 rounded-full"></span>
                        <%= subscription.github_repo_full_name %>
                      </div>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <p class="text-sm text-gray-400">
              No teams have subscribed to repositories yet. Teams can subscribe to repositories from their settings.
            </p>
          <% end %>
        </div>
      <% end %>

      <!-- How it Works -->
      <div class="bg-foreground border border-stroke rounded-lg p-6">
        <h2 class="text-lg font-semibold text-gray-200 mb-4">How Workspace Installation Works</h2>
        <div class="space-y-3 text-sm text-gray-400">
          <div class="flex gap-3">
            <span class="text-accent font-semibold">1.</span>
            <p><strong>Workspace Admin</strong> installs the GitHub App once for the entire workspace.</p>
          </div>
          <div class="flex gap-3">
            <span class="text-accent font-semibold">2.</span>
            <p><strong>Team Members</strong> can then subscribe their teams to specific repositories from the installation.</p>
          </div>
          <div class="flex gap-3">
            <span class="text-accent font-semibold">3.</span>
            <p><strong>Smart Routing:</strong> PRs are only processed for teams whose issue shortcodes appear in the PR (e.g., <code class="px-1 py-0.5 bg-background rounded font-mono">ENG-123</code>).</p>
          </div>
          <div class="flex gap-3">
            <span class="text-accent font-semibold">4.</span>
            <p><strong>Multi-Team Support:</strong> Multiple teams can subscribe to the same repository if they collaborate on it.</p>
          </div>
        </div>
      </div>

      <!-- Requirements -->
      <div class="bg-foreground border border-stroke rounded-lg p-6">
        <h2 class="text-lg font-semibold text-gray-200 mb-4">Requirements</h2>
        <ul class="space-y-2 text-sm text-gray-400 list-disc list-inside">
          <li>You must be a workspace owner or admin to install the GitHub App</li>
          <li>Once installed, any team member can subscribe their team to repositories</li>
          <li>Webhook endpoint must be publicly accessible (use ngrok for local development)</li>
        </ul>
      </div>
    </div>
  </div>
</div>
