<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Just Another Issue Tracker" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Just Another Issue Tracker">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>
    <link rel="icon" href="/icon.png" type="image/png">
    <%# <link rel="icon" href="/icon.svg" type="image/svg+xml"> %>
    <link rel="apple-touch-icon" href="/icon.png">
    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="<%= controller_name == 'landing' ? 'bg-background' : 'bg-background text-gray-100 h-screen overflow-hidden flex' %>" data-controller="keyboard-shortcuts<%= ' sidebar notification-drawer' if authenticated? && controller_name != 'landing' %>">
    <% if authenticated? && controller_name != 'landing' %>
      <!-- Mobile drawer (hidden by default) -->
      <div id="mobile-drawer" class="fixed inset-0 z-50 hidden sm:hidden">
        <!-- Overlay -->
        <div id="mobile-drawer-overlay" class="absolute inset-0 bg-black/50" data-action="click->sidebar#close"></div>
        <!-- Drawer panel -->
        <div id="mobile-drawer-panel" class="absolute inset-y-0 left-0 w-64 bg-menu border-r border-stroke flex flex-col transform -translate-x-full transition-transform duration-200 ease-in-out">
          <!-- Header with close button -->
          <div class="h-14 px-4 border-b border-stroke flex items-center justify-between shrink-0">
            <div class="flex items-center gap-2">
              <div id="mobile_drawer_avatar">
                <%= user_avatar(current_user, shape: "square") %>
              </div>
              <span class="text-sm font-medium"><%= current_user.name %></span>
            </div>
            <div class="flex items-center gap-1">
              <button type="button"
                      class="relative p-1.5 text-gray-400 hover:text-gray-200 rounded-md hover:bg-gray-800 cursor-pointer"
                      data-action="click->notification-drawer#toggle"
                      aria-label="Notifications">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path>
                </svg>
                <% unread_count = current_user.notifications.unread.count %>
                <%= render "notifications/badge", count: unread_count %>
              </button>
              <button type="button" class="p-1 text-gray-400 hover:text-gray-200" data-action="click->sidebar#close">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
              </button>
            </div>
          </div>
          <!-- Navigation -->
          <div class="flex-1 overflow-y-auto">
            <% if current_team.present? %>
              <div class="p-2">
                <div class="text-xs font-medium text-gray-500 uppercase px-2 mb-2">Workspace</div>
                <div class="space-y-1">
                  <%= link_to team_issues_path(current_team, assignee_id: current_user.id), class: "flex items-center gap-2 px-2 py-1.5 text-sm rounded hover:bg-foreground text-gray-300", data: { action: "click->sidebar#close" } do %>
                    <span>My issues</span>
                  <% end %>
                </div>
              </div>
            <% end %>
            <div class="p-2 mt-4" data-controller="teams-section">
              <div class="flex items-center justify-between px-2 mb-2">
                <button data-action="click->teams-section#toggle"
                        class="flex items-center gap-1 text-xs font-medium text-gray-500 uppercase flex-1 text-left hover:text-gray-400">
                  <svg data-teams-section-target="chevron"
                       class="w-3 h-3 transition-transform"
                       fill="currentColor"
                       viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"></path>
                  </svg>
                  <span>Your Teams</span>
                </button>
                <%= link_to new_team_path, class: "p-1 text-gray-500 hover:text-gray-300", data: { action: "click->sidebar#close" } do %>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                  </svg>
                <% end %>
              </div>
              <div class="space-y-1" data-teams-section-target="list">
                <% user_teams.each do |team| %>
                  <% is_current = team.id == current_team&.id %>
                  <div data-controller="team-nav"
                       data-current-team="<%= is_current %>">
                    <!-- Team row -->
                    <div class="flex items-center gap-1 px-2 py-1.5 rounded cursor-pointer hover:bg-foreground text-sm <%= 'bg-foreground text-gray-100' if is_current %> <%= 'text-gray-300' unless is_current %>"
                         data-action="click->team-nav#toggle">
                      <svg data-team-nav-target="chevron"
                           class="w-3 h-3 text-gray-500 transition-transform shrink-0"
                           fill="currentColor"
                           viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
                      </svg>
                      <span class="font-mono text-xs text-gray-500"><%= team.identifier %></span>
                      <span class="truncate"><%= team.name %></span>
                    </div>

                    <!-- Sub-navigation -->
                    <div data-team-nav-target="subNav" class="hidden ml-4 mt-0.5 space-y-0.5">
                      <%= link_to team_issues_path(team),
                          class: "flex items-center gap-2 px-3 py-1 text-sm rounded hover:bg-foreground transition-colors #{request.path == team_issues_path(team) ? 'text-gray-100 bg-foreground' : 'text-gray-400'}",
                          data: { action: "click->sidebar#close" } do %>
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
                        </svg>
                        <span>Issues</span>
                      <% end %>
                      <%= link_to team_projects_path(team),
                          class: "flex items-center gap-2 px-3 py-1 text-sm rounded hover:bg-foreground transition-colors #{request.path.start_with?(team_projects_path(team)) ? 'text-gray-100 bg-foreground' : 'text-gray-400'}",
                          data: { action: "click->sidebar#close" } do %>
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
                        </svg>
                        <span>Projects</span>
                      <% end %>
                      <%= link_to team_milestones_path(team),
                          class: "flex items-center gap-2 px-3 py-1 text-sm rounded hover:bg-foreground transition-colors #{request.path.start_with?(team_milestones_path(team)) ? 'text-gray-100 bg-foreground' : 'text-gray-400'}",
                          data: { action: "click->sidebar#close" } do %>
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        <span>Milestones</span>
                      <% end %>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
          <!-- Actions -->
          <% if current_team.present? %>
            <div class="p-4 border-t border-stroke">
              <%= link_to new_import_path, class: "text-xs text-gray-400 hover:text-gray-300 block", data: { action: "click->sidebar#close" } do %>
                Import CSV
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
      <!-- Desktop sidebar -->
      <%= render "shared/sidebar" %>
      <!-- Notification drawer -->
      <%= render "notifications/drawer" %>
    <% end %>
    <% if controller_name == 'landing' %>
      <%= yield %>
    <% else %>
      <main class="flex-1 flex flex-col overflow-hidden">
        <%= yield %>
      </main>
    <% end %>
    <%= render "shared/keyboard_shortcuts_modal" if authenticated? && controller_name != 'landing' %>
  </body>
</html>
