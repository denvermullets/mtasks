<!DOCTYPE html>
<html data-theme="<%= authenticated? ? current_user.theme : 'default' %>" data-font="<%= authenticated? ? current_user.font : 'inter' %>">
  <head>
    <title><%= content_for(:title) || "Just Another Issue Tracker" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Just Another Issue Tracker">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%# tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>
    <link rel="icon" href="/icon.png" type="image/png">
    <%# <link rel="icon" href="/icon.svg" type="image/svg+xml"> %>
    <link rel="apple-touch-icon" href="/icon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible+Mono:wght@400;500;600;700&family=Fira+Code:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500;600;700&family=IBM+Plex+Sans:wght@400;500;600;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Roboto+Mono:wght@400;500;600;700&family=SUSE+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap">
    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="<%= controller_name == 'landing' ? 'bg-background' : 'bg-background text-gray-100 h-dvh overflow-hidden flex' %>" data-controller="keyboard-shortcuts<%= ' sidebar notification-drawer dashboard-form' if authenticated? && controller_name != 'landing' %><%= vektis_controller_token %>"<%= vektis_body_attributes %>>
    <% if authenticated? && controller_name != 'landing' %>
      <!-- Mobile drawer (hidden by default) -->
      <div id="mobile-drawer" class="fixed inset-0 z-50 hidden sm:hidden">
        <!-- Overlay -->
        <div id="mobile-drawer-overlay" class="absolute inset-0 bg-black/50" data-action="click->sidebar#close"></div>
        <!-- Drawer panel -->
        <div id="mobile-drawer-panel" class="absolute inset-y-0 left-0 w-64 bg-menu border-r border-stroke flex flex-col transform -translate-x-full transition-transform duration-200 ease-in-out">
          <!-- Header with close button -->
          <div class="h-14 px-4 border-b border-stroke flex items-center justify-between shrink-0">
            <div id="mobile_drawer_avatar" class="flex items-center gap-2">
              <%= user_avatar(current_user) %>
              <span class="text-sm font-medium"><%= current_user.name %></span>
            </div>
            <div class="flex items-center gap-1">
              <button type="button"
                      class="relative p-1.5 text-gray-400 hover:text-gray-200 rounded-md hover:bg-gray-800 cursor-pointer"
                      data-action="click->notification-drawer#toggle"
                      aria-label="Notifications">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path>
                </svg>
                <% unread_count = current_user.notifications.unread.count %>
                <%= render "notifications/badge", count: unread_count %>
              </button>
              <button type="button" class="p-1 text-gray-400 hover:text-gray-200" data-action="click->sidebar#close">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
              </button>
            </div>
          </div>
          <!-- Navigation -->
          <div class="flex-1 overflow-y-auto">
            <% if current_team.present? %>
              <div class="p-2">
                <div class="text-xs font-medium text-gray-500 uppercase px-2 mb-2">Workspace</div>
                <div class="space-y-1">
                  <%= link_to team_issues_path(current_team, assignee_ids: current_user.id), class: "flex items-center gap-2 px-2 py-1.5 text-sm rounded hover:bg-foreground text-gray-300", data: { action: "click->sidebar#close" } do %>
                    <span>My issues</span>
                  <% end %>
                </div>
              </div>
            <% end %>
            <%= render "shared/sidebar_dashboards", mobile: true %>
            <%= render "shared/sidebar_saved_views", mobile: true %>
            <%= render "shared/sidebar_teams", layout: sidebar_team_layout, mobile: true %>
          </div>
          <!-- Actions -->
          <div class="p-4 border-t border-stroke space-y-2">
            <% if current_team.present? %>
              <%= link_to new_import_path, class: "text-xs text-gray-400 hover:text-gray-300 block", data: { action: "click->sidebar#close" } do %>
                Import CSV
              <% end %>
            <% end %>
            <%= link_to changelog_path, class: "text-xs text-gray-400 hover:text-gray-300 block", data: { action: "click->sidebar#close" } do %>
              What's new
            <% end %>
          </div>
        </div>
      </div>
      <!-- Desktop sidebar -->
      <%= render "shared/sidebar" %>
      <!-- Notification drawer -->
      <%= render "notifications/drawer" %>
    <% end %>
    <% if controller_name == 'landing' %>
      <%= yield %>
    <% else %>
      <main class="flex-1 flex flex-col overflow-hidden">
        <%= yield %>
      </main>
    <% end %>
    <% if authenticated? && controller_name != 'landing' %>
      <%= render "shared/keyboard_shortcuts_modal" %>
      <%= render "dashboards/form_modal", dashboard: @form_dashboard || Dashboard.new %>
    <% end %>
  </body>
</html>
