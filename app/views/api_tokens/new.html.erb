<div class="min-h-screen flex justify-center px-4 pt-[10vh]">
  <div class="mx-auto md:w-2/3 w-full max-w-xl">
    <h1 class="font-bold text-4xl mb-2 text-gray-100">New API Token</h1>
    <p class="text-sm text-gray-400 mb-6">Scope a token to a team and permission level. The raw value is shown once after creation.</p>

    <%= form_with url: api_tokens_path, method: :post, local: true, data: { turbo: false } do |f| %>
      <div class="bg-foreground border border-stroke rounded-lg p-5 space-y-5">
        <div>
          <%= f.label :"api_token[name]", "Name", class: "block text-sm font-medium text-gray-200 mb-1" %>
          <%= f.text_field :"api_token[name]", required: true, placeholder: "e.g. Slack integration",
                class: "w-full rounded-md bg-background border border-stroke text-gray-100 px-3 py-2 text-sm focus:outline-none focus:border-accent" %>
          <p class="text-xs text-gray-500 mt-1">Use a name that identifies where this token will be used.</p>
        </div>

        <div>
          <%= f.label :"api_token[team_id]", "Team scope", class: "block text-sm font-medium text-gray-200 mb-1" %>
          <%= f.select :"api_token[team_id]",
                options_for_select([['All teams you belong to', '']] + @teams.map { |t| [t.name, t.id] }),
                {},
                class: "w-full rounded-md bg-background border border-stroke text-gray-100 px-3 py-2 text-sm focus:outline-none focus:border-accent" %>
          <p class="text-xs text-gray-500 mt-1">Restrict this token to a single team, or leave as "All teams" for multi-team use.</p>
        </div>

        <fieldset>
          <legend class="block text-sm font-medium text-gray-200 mb-2">Permissions</legend>
          <div class="space-y-2">
            <label class="flex items-start gap-2 cursor-pointer">
              <input type="radio" name="api_token[permission]" value="write" checked class="mt-1 accent-accent">
              <span class="text-sm">
                <span class="text-gray-200 font-medium">Read &amp; write</span>
                <span class="block text-xs text-gray-500">Can read and modify resources. Use for scripts, MCP, CI.</span>
              </span>
            </label>
            <label class="flex items-start gap-2 cursor-pointer">
              <input type="radio" name="api_token[permission]" value="read" class="mt-1 accent-accent">
              <span class="text-sm">
                <span class="text-gray-200 font-medium">Read only</span>
                <span class="block text-xs text-gray-500">Can only read. Use for unfurling cards, dashboards, reporting.</span>
              </span>
            </label>
          </div>
        </fieldset>

        <div class="flex items-center gap-2 pt-2">
          <%= f.submit "Generate token",
                class: "rounded-md px-3.5 py-2.5 border border-accent text-gray-200 hover:bg-accent hover:text-gray-800 font-medium cursor-pointer" %>
          <%= link_to "Cancel", api_tokens_path, class: "text-sm text-gray-400 hover:text-gray-300 px-3 py-2" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
