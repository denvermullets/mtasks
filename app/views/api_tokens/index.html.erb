<div class="min-h-screen flex justify-center px-4 pt-[10vh]">
  <div class="mx-auto md:w-2/3 w-full max-w-3xl">
    <% if notice = flash[:notice] %>
      <p class="py-2 px-3 bg-green-900/20 border border-green-800 mb-5 text-green-400 font-medium rounded-lg inline-block"><%= notice %></p>
    <% end %>
    <% if alert = flash[:alert] %>
      <p class="py-2 px-3 bg-red-900/20 border border-red-800 mb-5 text-red-400 font-medium rounded-lg inline-block"><%= alert %></p>
    <% end %>

    <div class="flex items-start justify-between mb-6 gap-4">
      <div>
        <h1 class="font-bold text-4xl mb-2 text-gray-100">API Tokens</h1>
        <p class="text-sm text-gray-400">Generate tokens to authenticate integrations — chat apps, the MCP server, CI, or scripts. You can have multiple named tokens, each scoped to a team and a permission level.</p>
      </div>
      <%= link_to "New token", new_api_token_path,
            class: "rounded-md px-3.5 py-2.5 border border-accent text-gray-200 hover:bg-accent hover:text-gray-800 font-medium cursor-pointer shrink-0" %>
    </div>

    <% if @new_token_value.present? %>
      <div class="bg-yellow-900/20 border border-yellow-700 rounded-lg p-4 mb-6">
        <h3 class="font-semibold text-yellow-400 mb-2">Your new API token</h3>
        <p class="text-sm text-yellow-300/80 mb-3">Copy this token now. It won't be shown again.</p>
        <div class="flex items-center gap-2">
          <code id="api-token-value" class="text-sm bg-background text-gray-300 p-2 block rounded flex-1 overflow-x-auto select-all"><%= @new_token_value %></code>
          <button type="button"
                  onclick="navigator.clipboard.writeText(document.getElementById('api-token-value').textContent)"
                  class="rounded-md px-3 py-2 bg-foreground hover:bg-highlight text-gray-300 text-sm font-medium shrink-0">
            Copy
          </button>
        </div>
      </div>
    <% end %>

    <div class="bg-foreground border border-stroke rounded-lg">
      <% if @api_tokens.any? %>
        <ul class="divide-y divide-stroke">
          <% @api_tokens.each do |token| %>
            <li class="flex items-center justify-between px-4 py-3 gap-4">
              <div class="min-w-0">
                <h3 class="font-semibold text-gray-200 truncate"><%= token.name %></h3>
                <p class="text-xs text-gray-400 mt-1 flex flex-wrap gap-x-2 gap-y-1">
                  <span>
                    <%= token.scoped_to_team? ? "Team: #{token.team.name}" : 'All teams' %>
                  </span>
                  <span>&middot;</span>
                  <span><%= token.can_write? ? 'Read &amp; write'.html_safe : 'Read only' %></span>
                  <span>&middot;</span>
                  <span>Created <%= time_ago_in_words(token.created_at) %> ago</span>
                  <span>&middot;</span>
                  <% if token.last_used_at %>
                    <span>Last used <%= time_ago_in_words(token.last_used_at) %> ago</span>
                  <% else %>
                    <span>Never used</span>
                  <% end %>
                </p>
              </div>
              <%= button_to "Revoke", api_token_path(token), method: :delete,
                    class: "rounded-md px-3 py-2 bg-red-900/30 border border-red-800 text-red-400 hover:bg-red-900/50 text-sm font-medium cursor-pointer shrink-0",
                    data: { turbo_confirm: "Revoke '#{token.name}'? Any integration using it will stop working." } %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <div class="text-center py-8 px-4">
          <p class="text-gray-400 mb-4">No active API tokens.</p>
          <%= link_to "Generate your first token", new_api_token_path,
                class: "rounded-md px-3.5 py-2.5 border border-accent text-gray-200 hover:bg-accent hover:text-gray-800 font-medium cursor-pointer inline-block" %>
        </div>
      <% end %>
    </div>

    <div class="mt-6">
      <%= link_to "Back", root_path, class: "text-sm text-gray-400 hover:text-gray-300" %>
    </div>
  </div>
</div>
