<%# locals: (mobile: false) %>
<%# Rendered by both the desktop sidebar and the mobile drawer; `mobile` adds the drawer-close action. %>
<div class="p-2">
  <div class="flex items-center justify-between px-2 mb-1">
    <span class="text-xs text-gray-500 <%= 'font-medium uppercase' if mobile %>">Dashboards</span>
    <button type="button"
            data-action="<%= 'click->sidebar#close ' if mobile %>click->dashboard-form#open"
            data-dashboard-form-url-param="<%= dashboards_path %>"
            data-dashboard-form-method-param="post"
            data-dashboard-form-title-param="New dashboard"
            data-dashboard-form-submit-param="Create"
            class="p-1 text-gray-500 hover:text-gray-300 cursor-pointer"
            aria-label="New dashboard">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
      </svg>
    </button>
  </div>
  <% if sidebar_dashboards.any? %>
    <div class="space-y-1">
      <% sidebar_dashboards.each do |dashboard| %>
        <%= link_to dashboard_path(dashboard),
            class: "flex items-center gap-2 px-2 py-1.5 text-sm rounded hover:bg-foreground cursor-pointer #{request.path == dashboard_path(dashboard) ? 'text-gray-100 bg-foreground' : 'text-gray-300'}",
            data: (mobile ? { action: "click->sidebar#close" } : {}) do %>
          <svg class="w-4 h-4 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path>
          </svg>
          <span class="truncate"><%= dashboard.name %></span>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
