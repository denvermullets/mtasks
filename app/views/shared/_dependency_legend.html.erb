<div class="inline-flex items-center gap-4 rounded-lg bg-foreground border border-stroke px-3 py-1.5 text-xs text-gray-400">
  <% [["blocks", "blocks"], ["blocked-by", "blocked by"], ["relates", "relates to"], ["duplicates", "duplicates"]].each do |var, label| %>
    <span class="inline-flex items-center gap-1.5">
      <span class="w-2 h-2 rounded-full" style="background-color: var(--dep-<%= var %>)"></span>
      <%= label %>
    </span>
  <% end %>
</div>
