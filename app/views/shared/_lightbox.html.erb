<!-- Lightbox Overlay -->
<div data-lightbox-target="overlay"
     data-action="click->lightbox#closeOnOverlay"
     class="hidden fixed inset-0 z-[100] bg-black/90 flex items-center justify-center p-8">
  <button type="button" data-action="click->lightbox#close"
          class="absolute top-4 right-4 text-gray-400 hover:text-white p-2">
    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
    </svg>
  </button>
  <img data-lightbox-target="image" class="max-w-full max-h-full object-contain rounded" src="" alt="">
</div>
