<div class="px-4 py-3 rounded border border-stroke border-l-4 <%= type == 'alert' ? 'border-l-red-500' : 'border-l-accent' %> bg-context-foreground text-gray-100 mb-2"
     data-controller="flash"
     data-action="click->flash#close">
  <div class="flex items-center justify-between">
    <span class="text-sm"><%= message %></span>
    <button type="button" class="text-gray-400 hover:text-gray-100 cursor-pointer">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
  </div>
</div>
