<div data-keyboard-shortcuts-target="modal"
     data-action="click->keyboard-shortcuts#closeOnBackdrop"
     class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
  <div class="bg-foreground border border-stroke rounded-lg p-6 max-w-2xl w-full mx-4 max-h-[80vh] overflow-y-auto">
    <div class="flex justify-between items-center mb-6">
      <h3 class="text-lg font-semibold text-gray-200">Keyboard Shortcuts</h3>
      <button type="button"
              data-action="click->keyboard-shortcuts#hideModal"
              class="text-gray-400 hover:text-gray-200">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <div class="space-y-6">
      <!-- Global Shortcuts -->
      <div>
        <h4 class="text-sm font-medium text-gray-300 mb-3">Global</h4>
        <div class="space-y-2">
          <div class="flex justify-between items-center py-2">
            <span class="text-sm text-gray-400">Show keyboard shortcuts</span>
            <kbd class="px-2 py-1 text-xs font-semibold text-gray-200 bg-background border border-stroke rounded">
              <span class="text-gray-400">⌘</span> K
            </kbd>
          </div>
          <div class="flex justify-between items-center py-2">
            <span class="text-sm text-gray-400">Close modals</span>
            <kbd class="px-2 py-1 text-xs font-semibold text-gray-200 bg-background border border-stroke rounded">Esc</kbd>
          </div>
          <div class="flex justify-between items-center py-2">
            <span class="text-sm text-gray-400">Focus issue search</span>
            <kbd class="px-2 py-1 text-xs font-semibold text-gray-200 bg-background border border-stroke rounded">
              <span class="text-gray-400">⌘</span> <span class="text-gray-400">⇧</span> F
            </kbd>
          </div>
        </div>
      </div>

      <!-- Board View Shortcuts -->
      <div>
        <h4 class="text-sm font-medium text-gray-300 mb-3">Board View</h4>
        <div class="space-y-2">
          <div class="flex justify-between items-center py-2">
            <span class="text-sm text-gray-400">Create new issue</span>
            <kbd class="px-2 py-1 text-xs font-semibold text-gray-200 bg-background border border-stroke rounded">C</kbd>
          </div>
          <div class="flex justify-between items-center py-2">
            <span class="text-sm text-gray-400">Open labels (on hovered card)</span>
            <kbd class="px-2 py-1 text-xs font-semibold text-gray-200 bg-background border border-stroke rounded">L</kbd>
          </div>
          <div class="flex justify-between items-center py-2">
            <span class="text-sm text-gray-400">Open status/lane (on hovered card)</span>
            <kbd class="px-2 py-1 text-xs font-semibold text-gray-200 bg-background border border-stroke rounded">S</kbd>
          </div>
          <div class="flex justify-between items-center py-2">
            <span class="text-sm text-gray-400">Open priority (on hovered card)</span>
            <kbd class="px-2 py-1 text-xs font-semibold text-gray-200 bg-background border border-stroke rounded">P</kbd>
          </div>
          <div class="flex justify-between items-center py-2">
            <span class="text-sm text-gray-400">Open project (on hovered card)</span>
            <kbd class="px-2 py-1 text-xs font-semibold text-gray-200 bg-background border border-stroke rounded">J</kbd>
          </div>
        </div>
      </div>

      <!-- Issue Sidebar Shortcuts -->
      <div>
        <h4 class="text-sm font-medium text-gray-300 mb-3">Issue Sidebar</h4>
        <div class="space-y-2">
          <div class="flex justify-between items-center py-2">
            <span class="text-sm text-gray-400">Open labels</span>
            <kbd class="px-2 py-1 text-xs font-semibold text-gray-200 bg-background border border-stroke rounded">L</kbd>
          </div>
          <div class="flex justify-between items-center py-2">
            <span class="text-sm text-gray-400">Open status/lane</span>
            <kbd class="px-2 py-1 text-xs font-semibold text-gray-200 bg-background border border-stroke rounded">S</kbd>
          </div>
          <div class="flex justify-between items-center py-2">
            <span class="text-sm text-gray-400">Open priority</span>
            <kbd class="px-2 py-1 text-xs font-semibold text-gray-200 bg-background border border-stroke rounded">P</kbd>
          </div>
          <div class="flex justify-between items-center py-2">
            <span class="text-sm text-gray-400">Open project</span>
            <kbd class="px-2 py-1 text-xs font-semibold text-gray-200 bg-background border border-stroke rounded">J</kbd>
          </div>
        </div>
      </div>

      <!-- Picker Navigation -->
      <div>
        <h4 class="text-sm font-medium text-gray-300 mb-3">Within Pickers</h4>
        <div class="space-y-2">
          <div class="flex justify-between items-center py-2">
            <span class="text-sm text-gray-400">Navigate down</span>
            <kbd class="px-2 py-1 text-xs font-semibold text-gray-200 bg-background border border-stroke rounded">↓</kbd>
          </div>
          <div class="flex justify-between items-center py-2">
            <span class="text-sm text-gray-400">Navigate up</span>
            <kbd class="px-2 py-1 text-xs font-semibold text-gray-200 bg-background border border-stroke rounded">↑</kbd>
          </div>
          <div class="flex justify-between items-center py-2">
            <span class="text-sm text-gray-400">Select item</span>
            <kbd class="px-2 py-1 text-xs font-semibold text-gray-200 bg-background border border-stroke rounded">Enter</kbd>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-6 pt-4 border-t border-stroke">
      <p class="text-xs text-gray-500 text-center">
        Press <kbd class="px-1 py-0.5 text-xs font-semibold text-gray-400 bg-background border border-stroke rounded"><span class="text-gray-500">⌘</span> K</kbd> anytime to view these shortcuts
      </p>
    </div>
  </div>
</div>
