<div id="avatar_color_picker" data-controller="avatar-color-picker" class="relative">
  <button type="button" data-action="click->avatar-color-picker#toggle" class="flex items-center gap-2 -mx-1 px-1 py-1 rounded hover:bg-hover-highlight cursor-pointer">
    <div id="sidebar_avatar">
      <%= user_avatar(current_user) %>
    </div>
    <span class="text-sm font-medium text-gray-200"><%= current_user.name %></span>
  </button>
  <div data-avatar-color-picker-target="popover" class="hidden absolute z-50 mt-2 p-1 bg-foreground border border-stroke rounded-lg shadow-lg min-w-[180px]">
    <%= link_to settings_appearance_path, class: "block px-2 py-1.5 text-xs text-gray-300 hover:text-gray-100 rounded hover:bg-hover-highlight" do %>
      Appearance
    <% end %>
    <%= link_to api_tokens_path, class: "block px-2 py-1.5 text-xs text-gray-300 hover:text-gray-100 rounded hover:bg-hover-highlight" do %>
      API Tokens
    <% end %>
    <% if current_team&.workspace %>
      <%= link_to workspace_settings_hourglass_integration_path(current_team.workspace), class: "block px-2 py-1.5 text-xs text-gray-300 hover:text-gray-100 rounded hover:bg-hover-highlight" do %>
        Integrations
      <% end %>
    <% end %>
    <div class="border-t border-stroke my-1"></div>
    <%= button_to session_path, method: :delete, class: "block w-full text-left px-2 py-1.5 text-xs text-gray-300 hover:text-gray-100 rounded hover:bg-hover-highlight cursor-pointer" do %>
      Sign out
    <% end %>
  </div>
</div>
