<div style="max-width: 600px; margin: 0 auto; padding: 20px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
  <h2 style="color: #333; margin-bottom: 16px;">You've been added to a team!</h2>

  <p style="color: #555; line-height: 1.6;">
    <strong><%= @added_by.name %></strong> has added you to
    <strong><%= @team.name %></strong>.
  </p>

  <p style="margin: 24px 0;">
    <a href="<%= @team_url %>"
       style="display: inline-block; padding: 12px 24px; background-color: #92E8D4; color: #1a1a2e; text-decoration: none; border-radius: 6px; font-weight: 500;">
      Go to Team
    </a>
  </p>

  <p style="color: #888; font-size: 14px; line-height: 1.5;">
    If the button above doesn't work, copy and paste this link into your browser:<br>
    <a href="<%= @team_url %>" style="color: #92E8D4;"><%= @team_url %></a>
  </p>
</div>
