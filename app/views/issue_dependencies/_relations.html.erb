<% frame_id = "issue_relations#{'_mobile' if local_assigns[:mobile]}" %>
<%= turbo_frame_tag frame_id do %>
  <%# Partition the preloaded link records in memory; no per-row queries. %>
  <% outgoing = issue.outgoing_links.to_a %>
  <% incoming = issue.incoming_links.to_a %>
  <% blocking_deps = outgoing.select(&:blocks?) %>
  <% blocked_by_deps = incoming.select(&:blocks?) %>
  <% related_rows = outgoing.select(&:relates?).map { |dep| [dep, dep.blocked_issue] } +
                    incoming.select(&:relates?).map { |dep| [dep, dep.blocking_issue] } %>
  <% duplicate_rows = outgoing.select(&:duplicates?).map { |dep| [dep, dep.blocked_issue, "Duplicates"] } +
                      incoming.select(&:duplicates?).map { |dep| [dep, dep.blocking_issue, "Duplicated by"] } %>

  <div data-controller="dependency-modal"
       data-dependency-modal-search-url-value="<%= search_team_issue_issue_dependencies_path(issue.team, issue) %>">

    <% if local_assigns[:alert].present? %>
      <div class="mb-3 px-3 py-2 rounded-md border border-red-500/40 bg-red-500/10 text-xs text-red-400">
        <%= alert %>
      </div>
    <% end %>

    <!-- Blocking -->
    <div class="mb-6">
      <div class="flex items-center gap-1.5 text-xs font-medium text-gray-500 mb-2">
        <span class="w-1.5 h-1.5 rounded-full bg-purple-500"></span>
        Blocking
      </div>
      <% blocking_deps.each do |dep| %>
        <%= render "issue_dependencies/relation_row", issue: issue, other: dep.blocked_issue, dep: dep, frame_id: frame_id %>
      <% end %>
      <%= render "issue_dependencies/add_button", direction: "blocking", text: "Add blocking issue..." %>
    </div>

    <!-- Blocked By -->
    <div class="mb-6">
      <div class="flex items-center gap-1.5 text-xs font-medium text-gray-500 mb-2">
        <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>
        Blocked by
      </div>
      <% blocked_by_deps.each do |dep| %>
        <%= render "issue_dependencies/relation_row", issue: issue, other: dep.blocking_issue, dep: dep, frame_id: frame_id %>
      <% end %>
      <%= render "issue_dependencies/add_button", direction: "blocked_by", text: "Add blocked by issue..." %>
    </div>

    <!-- Related -->
    <div class="mb-6">
      <div class="flex items-center gap-1.5 text-xs font-medium text-gray-500 mb-2">
        <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span>
        Related
      </div>
      <% related_rows.each do |dep, other| %>
        <%= render "issue_dependencies/relation_row", issue: issue, other: other, dep: dep, frame_id: frame_id %>
      <% end %>
      <%= render "issue_dependencies/add_button", direction: "relates", text: "Add related issue..." %>
    </div>

    <!-- Duplicates -->
    <div class="mb-6">
      <div class="flex items-center gap-1.5 text-xs font-medium text-gray-500 mb-2">
        <span class="w-1.5 h-1.5 rounded-full bg-yellow-500"></span>
        Duplicates
      </div>
      <% duplicate_rows.each do |dep, other, label| %>
        <%= render "issue_dependencies/relation_row", issue: issue, other: other, dep: dep, frame_id: frame_id, label: label %>
      <% end %>
      <%= render "issue_dependencies/add_button", direction: "duplicates", text: "Mark as duplicate of..." %>
      <%= render "issue_dependencies/add_button", direction: "duplicated_by", text: "Add duplicate issue..." %>
    </div>

    <!-- Modal -->
    <div data-dependency-modal-target="modal" class="hidden fixed inset-0 z-50">
      <div class="absolute inset-0 bg-black bg-opacity-50"
           data-action="click->dependency-modal#closeOnBackdrop"></div>
      <div class="relative z-10 flex items-center justify-center min-h-screen p-4">
        <div class="bg-foreground border border-stroke rounded-lg w-full max-w-lg shadow-xl">
          <div class="px-4 pt-4 pb-2">
            <h3 class="text-sm font-medium text-gray-300" data-dependency-modal-target="title">
              Add blocking issues
            </h3>
          </div>

          <%= form_with url: bulk_create_team_issue_issue_dependencies_path(issue.team, issue),
                        method: :post,
                        data: { turbo_frame: frame_id } do |f| %>
            <input type="hidden" name="direction" value="blocking" data-dependency-modal-target="directionInput">

            <div class="px-4 pb-2">
              <input type="text"
                     data-dependency-modal-target="search"
                     data-action="input->dependency-modal#search"
                     placeholder="Search issues by title or identifier..."
                     class="w-full px-3 py-2 bg-background border border-stroke rounded text-sm text-gray-200 placeholder-gray-500 focus:outline-none focus:border-accent"
                     autocomplete="off">
            </div>

            <div class="max-h-64 overflow-y-auto px-2 py-1">
              <turbo-frame id="dependency_search_results" data-dependency-modal-target="frame">
                <div class="px-3 py-8 text-center text-sm text-gray-500">Search for issues above</div>
              </turbo-frame>
            </div>

            <div class="px-4 py-3 border-t border-stroke flex items-center justify-end gap-2">
              <button type="button"
                      data-action="click->dependency-modal#close"
                      class="px-4 py-2 text-gray-400 hover:text-gray-300 cursor-pointer">
                Cancel
              </button>
              <button type="submit"
                      class="px-4 py-2 rounded-md border-accent border hover:bg-accent hover:text-gray-800 text-accent font-medium cursor-pointer transition-colors">
                Add issues
              </button>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
<% end %>
