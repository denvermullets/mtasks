<%= turbo_frame_tag "issue_relations" do %>
  <% blocked_issues = issue.blocked_issues.to_a %>
  <% blocking_issues = issue.blocking_issues.to_a %>
  <% existing_ids = blocked_issues.map(&:id) + blocking_issues.map(&:id) + [issue.id] %>
  <% candidates = issue.team.issues.not_archived.where.not(id: existing_ids).order(:team_number) %>

  <!-- Blocking -->
  <div class="mb-6">
    <div class="text-xs font-medium text-gray-500 mb-2">Blocking</div>
    <% blocked_issues.each do |blocked| %>
      <% dep = issue.blocking_dependencies.find_by(blocked_issue: blocked) %>
      <div class="flex items-center gap-2 px-3 py-1.5 rounded-md bg-foreground border border-stroke text-sm group mb-1">
        <%= link_to team_issue_path(issue.team, blocked),
            data: { turbo_frame: "_top" },
            class: "flex items-center gap-2 flex-1 min-w-0 text-gray-300 hover:text-accent transition-colors" do %>
          <span class="font-mono text-xs text-gray-500 shrink-0"><%= blocked.identifier %></span>
          <span class="truncate"><%= blocked.title %></span>
        <% end %>
        <% if dep %>
          <%= link_to team_issue_issue_dependency_path(issue.team, issue, dep),
              data: { turbo_method: :delete, turbo_frame: "issue_relations" },
              class: "shrink-0 text-gray-600 hover:text-red-400 opacity-0 group-hover:opacity-100 transition-all cursor-pointer" do %>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          <% end %>
        <% end %>
      </div>
    <% end %>
    <details class="relative">
      <summary class="w-full inline-flex items-center gap-2 px-3 py-1.5 rounded-md bg-foreground border border-stroke text-gray-500 text-sm hover:bg-hover-highlight transition-colors cursor-pointer list-none">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
        </svg>
        <span>Add blocking issue...</span>
      </summary>
      <div class="absolute top-full left-0 mt-1 w-full bg-foreground border border-stroke rounded-md shadow-lg z-10 max-h-48 overflow-y-auto">
        <% candidates.each do |candidate| %>
          <%= link_to team_issue_issue_dependencies_path(issue.team, issue, target_issue_id: candidate.id, direction: "blocking"),
              data: { turbo_method: :post, turbo_frame: "issue_relations" },
              class: "block px-3 py-2 text-sm text-gray-300 hover:bg-hover-highlight transition-colors cursor-pointer" do %>
            <span class="font-mono text-xs text-gray-500"><%= candidate.identifier %></span>
            <span class="ml-2"><%= candidate.title.truncate(30) %></span>
          <% end %>
        <% end %>
        <% if candidates.empty? %>
          <div class="px-3 py-3 text-sm text-gray-500 text-center">No available issues</div>
        <% end %>
      </div>
    </details>
  </div>

  <!-- Blocked By -->
  <div class="mb-6">
    <div class="text-xs font-medium text-gray-500 mb-2">Blocked by</div>
    <% blocking_issues.each do |blocker| %>
      <% dep = issue.blocked_dependencies.find_by(blocking_issue: blocker) %>
      <div class="flex items-center gap-2 px-3 py-1.5 rounded-md bg-foreground border border-stroke text-sm group mb-1">
        <%= link_to team_issue_path(issue.team, blocker),
            data: { turbo_frame: "_top" },
            class: "flex items-center gap-2 flex-1 min-w-0 text-gray-300 hover:text-accent transition-colors" do %>
          <span class="font-mono text-xs text-gray-500 shrink-0"><%= blocker.identifier %></span>
          <span class="truncate"><%= blocker.title %></span>
        <% end %>
        <% if dep %>
          <%= link_to team_issue_issue_dependency_path(issue.team, issue, dep),
              data: { turbo_method: :delete, turbo_frame: "issue_relations" },
              class: "shrink-0 text-gray-600 hover:text-red-400 opacity-0 group-hover:opacity-100 transition-all cursor-pointer" do %>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          <% end %>
        <% end %>
      </div>
    <% end %>
    <details class="relative">
      <summary class="w-full inline-flex items-center gap-2 px-3 py-1.5 rounded-md bg-foreground border border-stroke text-gray-500 text-sm hover:bg-hover-highlight transition-colors cursor-pointer list-none">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
        </svg>
        <span>Add blocked by issue...</span>
      </summary>
      <div class="absolute top-full left-0 mt-1 w-full bg-foreground border border-stroke rounded-md shadow-lg z-10 max-h-48 overflow-y-auto">
        <% candidates.each do |candidate| %>
          <%= link_to team_issue_issue_dependencies_path(issue.team, issue, target_issue_id: candidate.id, direction: "blocked_by"),
              data: { turbo_method: :post, turbo_frame: "issue_relations" },
              class: "block px-3 py-2 text-sm text-gray-300 hover:bg-hover-highlight transition-colors cursor-pointer" do %>
            <span class="font-mono text-xs text-gray-500"><%= candidate.identifier %></span>
            <span class="ml-2"><%= candidate.title.truncate(30) %></span>
          <% end %>
        <% end %>
        <% if candidates.empty? %>
          <div class="px-3 py-3 text-sm text-gray-500 text-center">No available issues</div>
        <% end %>
      </div>
    </details>
  </div>
<% end %>
