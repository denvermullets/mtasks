<button type="button"
        data-action="click->dependency-modal#open"
        data-dependency-modal-direction-param="<%= direction %>"
        class="w-full inline-flex items-center gap-2 px-3 py-1.5 rounded-md bg-foreground border border-stroke text-gray-500 text-sm hover:bg-hover-highlight transition-colors cursor-pointer mb-1">
  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
  </svg>
  <span><%= text %></span>
</button>
