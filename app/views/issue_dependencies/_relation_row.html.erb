<div class="flex items-center gap-2 px-3 py-1.5 rounded-md bg-foreground border border-stroke text-sm group mb-1">
  <% if local_assigns[:label] %>
    <span class="text-xs text-gray-500 shrink-0"><%= label %></span>
  <% end %>
  <%= link_to team_issue_path(issue.team, other),
      data: { turbo_frame: "_top", controller: "hover-card", "hover-card-url-value": card_team_issue_path(issue.team, other) },
      class: "flex items-center gap-2 flex-1 min-w-0 text-gray-300 hover:text-accent transition-colors" do %>
    <span class="font-mono text-xs text-gray-500 shrink-0"><%= other.identifier %></span>
    <span class="truncate"><%= other.title %></span>
  <% end %>
  <%= link_to team_issue_issue_dependency_path(issue.team, issue, dep),
      data: { turbo_method: :delete, turbo_frame: frame_id },
      class: "shrink-0 text-gray-600 hover:text-red-400 opacity-0 group-hover:opacity-100 transition-all cursor-pointer" do %>
    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
    </svg>
  <% end %>
</div>
