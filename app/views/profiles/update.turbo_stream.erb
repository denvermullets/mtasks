<%= turbo_stream.replace "sidebar_avatar" do %>
  <div id="sidebar_avatar">
    <%= user_avatar(current_user, shape: "square") %>
  </div>
<% end %>

<%= turbo_stream.replace "mobile_drawer_avatar" do %>
  <div id="mobile_drawer_avatar">
    <%= user_avatar(current_user, shape: "square") %>
  </div>
<% end %>

<%= turbo_stream.replace "avatar_color_picker" do %>
  <%= render "shared/avatar_color_picker" %>
<% end %>
