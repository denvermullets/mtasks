<div class="mb-1 activity-entry">
  <div class="text-xs text-gray-500">
    <%= reference.user.name %>
    referenced this issue in
    <%= link_to team_issue_path(reference.source_issue.team, reference.source_issue),
        class: "inline-flex items-center gap-1 font-mono text-accent hover:underline align-middle",
        data: { turbo_frame: "_top", controller: "hover-card",
                "hover-card-url-value": card_team_issue_path(reference.source_issue.team, reference.source_issue) } do %>
      <%= reference.source_issue.identifier %>
      <span class="inline-flex shrink-0" title="<%= reference.source_issue.lane&.name %>">
        <%= render_lane_icon(reference.source_issue.lane) %>
      </span>
    <% end %>
    (<%= reference.source_issue.title %>)
    &middot; <%= time_ago_in_words(reference.created_at) %> ago
  </div>
</div>
