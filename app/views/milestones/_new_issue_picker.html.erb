<%
  team_id = local_assigns[:team_id]
%>
<div data-controller="new-issue-milestone-picker"
     data-new-issue-milestone-picker-team-id-value="<%= team_id %>">
  <!-- Hidden field for form submission -->
  <input type="hidden"
         name="issue[milestone_id]"
         value=""
         data-new-issue-milestone-picker-target="hiddenField" />

  <!-- Picker Overlay -->
  <div data-new-issue-milestone-picker-target="picker"
       class="hidden fixed z-50 w-80 bg-context-foreground border-2 border-stroke rounded-md shadow-2xl">
    <!-- Search Input -->
    <div class="p-2 border-b border-stroke">
      <input type="text"
             placeholder="Search or create milestones..."
             data-new-issue-milestone-picker-target="search"
             data-action="input->new-issue-milestone-picker#filterMilestones keydown->new-issue-milestone-picker#handleKeyDown"
             class="w-full px-3 py-2 text-sm bg-background border border-stroke rounded text-gray-200 placeholder-gray-500 focus:outline-none focus:border-accent" />
    </div>

    <!-- Create New Milestone Option (shown dynamically) -->
    <div data-new-issue-milestone-picker-target="createOption" class="hidden border-b border-stroke">
      <button type="button"
              data-action="click->new-issue-milestone-picker#createMilestone"
              data-new-issue-milestone-picker-target="createButton"
              class="w-full text-left px-3 py-2 text-sm text-accent hover:bg-hover-highlight transition-colors flex items-center gap-2">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
        </svg>
        <span>Create "<span data-new-issue-milestone-picker-target="createText"></span>"</span>
      </button>
    </div>

    <!-- Milestones List Container -->
    <div data-new-issue-milestone-picker-target="milestoneList" class="max-h-96 overflow-y-auto">
      <%= turbo_frame_tag "new_issue_milestone_list_frame",
                          src: team_milestones_path(team_id, context: 'new_issue'),
                          loading: :lazy do %>
        <!-- Loading State -->
        <div class="px-3 py-8 text-center">
          <div class="inline-block w-6 h-6 border-2 border-accent border-t-transparent rounded-full animate-spin"></div>
        </div>
      <% end %>
    </div>
  </div>
</div>
