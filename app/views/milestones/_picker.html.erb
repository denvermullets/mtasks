<%# Milestone Picker Component
  Usage: %= render "milestones/picker", issue: @issue, context: "sidebar" %
  Context can be: "sidebar" or "card"
%>

<%
  issue_id = issue.id
  team_id = issue.team_id
  current_milestone_id = issue.milestone_id || 0
  context ||= "sidebar"
%>

<div data-controller="milestone-picker"
     data-milestone-picker-issue-id-value="<%= issue_id %>"
     data-milestone-picker-team-id-value="<%= team_id %>"
     data-milestone-picker-context-value="<%= context %>"
     data-milestone-picker-current-milestone-value="<%= current_milestone_id %>"
     class="hidden fixed z-50 w-80 bg-context-foreground border-2 border-stroke rounded-md shadow-2xl"
     data-milestone-picker-target="picker">

  <!-- Header with issue identifier -->
  <div class="px-3 py-2 border-b border-stroke">
    <span class="text-xs text-gray-500"><%= issue.identifier %> • <%= issue.title.truncate(30) %></span>
  </div>

  <!-- Search Input -->
  <div class="p-2 border-b border-stroke">
    <input type="text"
           placeholder="Search or create milestones..."
           data-milestone-picker-target="search"
           data-action="input->milestone-picker#filterMilestones keydown->milestone-picker#handleKeyDown"
           class="w-full px-3 py-2 text-sm bg-background border border-stroke rounded text-gray-200 placeholder-gray-500 focus:outline-none focus:border-accent" />
  </div>

  <!-- Create New Milestone Option (shown dynamically) -->
  <div data-milestone-picker-target="createOption" class="hidden border-b border-stroke">
    <%= form_with model: Milestone.new,
                  url: team_milestones_path(team_id),
                  data: {
                    turbo_frame: "milestone_list_frame_#{issue_id}",
                    action: "turbo:submit-end->milestone-picker#handleCreate"
                  } do |f| %>
      <%= f.hidden_field :name, data: { milestone_picker_target: "nameField" } %>
      <button type="submit"
              data-milestone-picker-target="createButton"
              class="w-full text-left px-3 py-2 text-sm text-accent hover:bg-hover-highlight transition-colors flex items-center gap-2">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
        </svg>
        <span>Create "<span data-milestone-picker-target="createText"></span>"</span>
      </button>
    <% end %>
  </div>

  <!-- Milestones List Container -->
  <div data-milestone-picker-target="milestoneList" class="max-h-96 overflow-y-auto">
    <%= turbo_frame_tag "milestone_list_frame_#{issue_id}",
                        src: team_milestones_path(team_id, issue_id: issue_id, context: context),
                        loading: :lazy do %>
      <!-- Loading State -->
      <div class="px-3 py-8 text-center">
        <div class="inline-block w-6 h-6 border-2 border-accent border-t-transparent rounded-full animate-spin"></div>
      </div>
    <% end %>
  </div>
</div>
