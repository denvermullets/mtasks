<div id="lane_<%= lane.id %>"
     data-lane-url="<%= team_lane_path(lane.team, lane) %>"
     class="group flex items-center gap-2 px-2 py-1 bg-background border border-stroke rounded hover:bg-hover-highlight transition-colors">
  <!-- Drag handle -->
  <span data-lane-order-handle class="text-gray-500 hover:text-gray-300 cursor-grab active:cursor-grabbing p-0.5" title="Drag to reorder">
    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
      <path d="M7 4a1.5 1.5 0 110 3 1.5 1.5 0 010-3zm6 0a1.5 1.5 0 110 3 1.5 1.5 0 010-3zM7 8.5a1.5 1.5 0 110 3 1.5 1.5 0 010-3zm6 0a1.5 1.5 0 110 3 1.5 1.5 0 010-3zM7 13a1.5 1.5 0 110 3 1.5 1.5 0 010-3zm6 0a1.5 1.5 0 110 3 1.5 1.5 0 010-3z"></path>
    </svg>
  </span>

  <!-- Position -->
  <span class="text-xs text-gray-500 font-mono w-6 text-center">
    <%= lane.position + 1 %>
  </span>

  <!-- Lane name (editable) with auto-submit on blur -->
  <%= form_with model: lane, url: team_lane_path(lane.team, lane), method: :patch, data: { controller: "auto-submit" }, class: "flex-1 m-0" do |f| %>
    <%= f.text_field :name,
        data: { action: "blur->auto-submit#submit", auto_submit_original_value: lane.name },
        class: "w-full px-2 py-0.5 text-sm bg-transparent border border-transparent hover:border-stroke focus:border-accent focus:bg-background rounded text-gray-200 focus:outline-none" %>
  <% end %>

  <!-- Issue count badge -->
  <span class="text-xs text-gray-500 px-1.5 py-0.5 bg-foreground rounded whitespace-nowrap">
    <%= pluralize(lane.issues.count, 'issue') %>
  </span>

  <!-- Delete button -->
  <%= button_to team_lane_path(lane.team, lane),
      method: :delete,
      form: { data: { turbo_confirm: "Are you sure you want to delete this lane?" } },
      class: "text-gray-500 hover:text-red-500 transition-colors p-1 cursor-pointer",
      title: "Delete lane" do %>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
    </svg>
  <% end %>
</div>
