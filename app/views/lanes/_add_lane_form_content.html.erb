<div class="p-3 bg-background border border-stroke rounded">
  <%= form_with model: lane, url: team_lanes_path(lane.team_id || @team&.id || current_team&.id), method: :post do |f| %>
    <div class="flex items-start gap-2">
      <!-- Lane Name -->
      <div class="flex-1">
        <%= f.text_field :name,
            placeholder: "Lane name, e.g. In Review",
            required: true,
            autofocus: true,
            class: "w-full px-2 py-1 bg-background border border-stroke rounded text-gray-200 text-sm focus:outline-none focus:border-accent" %>
        <% if lane.errors[:name].any? %>
          <p class="text-red-500 text-xs mt-1"><%= lane.errors[:name].first %></p>
        <% end %>
      </div>

      <!-- Position (blank = add at end) -->
      <%= f.number_field :position,
          min: 0,
          placeholder: "Pos.",
          title: "Position (leave empty to add at end)",
          class: "w-20 px-2 py-1 bg-background border border-stroke rounded text-gray-200 text-sm focus:outline-none focus:border-accent" %>

      <button type="button"
              data-action="click->lane-settings#toggleAddLaneForm"
              class="px-3 py-1 text-sm text-gray-400 hover:text-gray-200 rounded cursor-pointer">
        Cancel
      </button>
      <%= f.submit "Add Lane", class: "px-3 py-1 text-sm bg-accent text-white rounded hover:bg-accent-hover cursor-pointer" %>
    </div>
  <% end %>
</div>
