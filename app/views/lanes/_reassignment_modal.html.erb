<div id="reassignment_modal_<%= lane.id %>" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50" data-controller="modal">
  <div class="bg-foreground border border-stroke rounded-lg p-6 max-w-md w-full mx-4">
    <h3 class="text-lg font-semibold text-gray-200 mb-4">Reassign Issues</h3>
    <p class="text-sm text-gray-400 mb-4">
      This lane has <%= pluralize(lane.issues.count, 'issue') %>.
      Please select a lane to move them to:
    </p>

    <%= form_with url: team_lane_path(lane.team, lane), method: :delete do |f| %>
      <div class="mb-4">
        <%= select_tag :target_lane_id,
            options_from_collection_for_select(available_lanes, :id, :name),
            prompt: "Select a lane...",
            required: true,
            class: "w-full px-3 py-2 bg-background border border-stroke rounded text-gray-200 focus:outline-none focus:border-accent" %>
      </div>

      <div class="flex gap-2 justify-end">
        <button type="button"
                data-action="click->modal#close"
                class="px-4 py-2 text-gray-400 hover:text-gray-200 rounded">
          Cancel
        </button>
        <%= f.submit "Delete Lane", class: "px-4 py-2 bg-red-600 text-white rounded hover:bg-red-700 cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>
