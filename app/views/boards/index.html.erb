<div class="h-screen flex flex-col">
  <!-- Header -->
  <div class="border-b border-gray-200 bg-white px-6 py-4">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-4">
        <h1 class="text-2xl font-semibold text-gray-900"><%= current_team.name %></h1>
        <span class="text-sm text-gray-500"><%= current_team.workspace.name %></span>
      </div>

      <div class="flex items-center gap-4">
        <!-- View Mode Switcher -->
        <div class="inline-flex rounded-lg border border-gray-300 p-1">
          <%= link_to "Priority", boards_path(view: "priority"),
              class: "px-3 py-1.5 text-sm font-medium rounded-md #{@view_mode == 'priority' ? 'bg-gray-100 text-gray-900' : 'text-gray-600 hover:text-gray-900'}" %>
          <%= link_to "Milestone", boards_path(view: "milestone"),
              class: "px-3 py-1.5 text-sm font-medium rounded-md #{@view_mode == 'milestone' ? 'bg-gray-100 text-gray-900' : 'text-gray-600 hover:text-gray-900'}" %>
        </div>

        <%= link_to "Import CSV", new_import_path, class: "px-3 py-2 text-sm font-medium text-white bg-blue-600 hover:bg-blue-500 rounded-md" %>
      </div>
    </div>
  </div>

  <!-- Board Content -->
  <div class="flex-1 overflow-auto bg-gray-50">
    <% if @view_mode == "milestone" %>
      <%= render "milestone_board" %>
    <% else %>
      <%= render "priority_board" %>
    <% end %>
  </div>
</div>
