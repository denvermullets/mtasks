<div class="p-6 space-y-8">
  <% @milestones.each do |milestone| %>
    <% milestone_issues = @issues.where(milestone: milestone) %>
    <% next if milestone_issues.none? %>

    <div class="border border-gray-300 rounded-lg bg-white">
      <!-- Milestone Header -->
      <div class="px-6 py-4 bg-gray-50 border-b border-gray-300 rounded-t-lg">
        <div class="flex items-center justify-between">
          <div>
            <h2 class="text-xl font-semibold text-gray-900"><%= milestone.name %></h2>
            <div class="flex items-center gap-4 mt-1">
              <span class="text-sm text-gray-600">
                <%= milestone_issues.count %> issues
              </span>
              <% if milestone.due_date %>
                <span class="text-sm <%= milestone.behind_schedule? ? 'text-red-600' : 'text-gray-600' %>">
                  Due <%= milestone.due_date.strftime("%b %d, %Y") %>
                </span>
              <% end %>
            </div>
          </div>
          <div class="text-right">
            <div class="text-2xl font-bold text-gray-900"><%= milestone.progress_percentage %>%</div>
            <div class="text-xs text-gray-500">Complete</div>
          </div>
        </div>
      </div>

      <!-- Projects within this milestone -->
      <div class="p-6 space-y-6">
        <% milestone.projects.each do |project| %>
          <% project_issues = milestone_issues.where(project: project) %>
          <% next if project_issues.none? %>

          <div class="border border-gray-200 rounded-lg">
            <!-- Project Header -->
            <div class="px-4 py-3 bg-blue-50 border-b border-blue-200 rounded-t-lg">
              <h3 class="text-base font-semibold text-blue-900"><%= project.name %></h3>
              <span class="text-sm text-blue-700"><%= project_issues.count %> issues</span>
            </div>

            <!-- Lanes for this project -->
            <div class="p-4 grid grid-cols-4 gap-4">
              <% @lanes.each do |lane| %>
                <div class="bg-gray-50 rounded border border-gray-200">
                  <div class="px-3 py-2 border-b border-gray-200">
                    <h4 class="text-xs font-medium text-gray-700"><%= lane.name %></h4>
                    <span class="text-xs text-gray-500">
                      <%= project_issues.where(lane: lane).count %>
                    </span>
                  </div>
                  <div class="p-2 space-y-2 min-h-[80px]">
                    <% project_issues.where(lane: lane).each do |issue| %>
                      <%= render "issue_card", issue: issue, compact: true %>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <!-- Ungrouped Issues -->
  <% if @ungrouped_issues.any? %>
    <div class="border border-gray-300 rounded-lg bg-white">
      <div class="px-6 py-4 bg-gray-50 border-b border-gray-300 rounded-t-lg">
        <h2 class="text-xl font-semibold text-gray-900">No Milestone</h2>
        <span class="text-sm text-gray-600"><%= @ungrouped_issues.count %> issues</span>
      </div>
      <div class="p-6 grid grid-cols-4 gap-4">
        <% @lanes.each do |lane| %>
          <div class="bg-gray-50 rounded border border-gray-200">
            <div class="px-3 py-2 border-b border-gray-200">
              <h4 class="text-xs font-medium text-gray-700"><%= lane.name %></h4>
              <span class="text-xs text-gray-500">
                <%= @ungrouped_issues.where(lane: lane).count %>
              </span>
            </div>
            <div class="p-2 space-y-2 min-h-[80px]">
              <% @ungrouped_issues.where(lane: lane).each do |issue| %>
                <%= render "issue_card", issue: issue, compact: true %>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
