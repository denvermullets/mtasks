<div data-controller="theme-preview">
  <div class="mb-4 flex items-baseline justify-between gap-3">
    <div>
      <h2 class="text-lg font-semibold text-gray-200">Appearance</h2>
      <p class="text-xs text-gray-400 mt-1">Pick a theme and font. Changes save automatically.</p>
    </div>
    <span class="text-xs font-medium opacity-0 transition-opacity duration-300 text-accent"
          data-theme-preview-target="status"
          role="status"
          aria-live="polite"></span>
  </div>
  <%= form_with url: settings_appearance_path, method: :patch,
                data: { theme_preview_target: "form", action: "turbo:submit-end->theme-preview#saved" } do |f| %>
    <div class="mb-6">
      <div class="text-sm font-medium text-gray-400 mb-3">Theme</div>
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
        <% @themes.each do |theme| %>
          <label class="relative cursor-pointer group">
            <input type="radio"
                   name="theme"
                   value="<%= theme[:id] %>"
                   <%= 'checked' if theme[:id] == current_user.theme %>
                   class="sr-only peer"
                   data-action="change->theme-preview#preview">
            <div class="rounded-lg border-2 p-4 transition-all duration-150
                        border-stroke hover:border-accent/60
                        peer-checked:border-accent peer-checked:bg-context-foreground
                        bg-background">
              <div class="flex items-center justify-between mb-3">
                <span class="text-xs text-gray-300 font-medium"><%= theme[:name] %></span>
              </div>
              <div class="flex gap-2">
                <% theme[:colors].each do |color| %>
                  <div class="w-6 h-6 rounded-full border border-stroke shrink-0" style="background-color: <%= color %>"></div>
                <% end %>
              </div>
            </div>
          </label>
        <% end %>
      </div>
    </div>
    <div>
      <div class="text-sm font-medium text-gray-400 mb-3">Font</div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <% @fonts.each do |font| %>
          <label class="relative cursor-pointer group">
            <input type="radio"
                   name="font"
                   value="<%= font[:id] %>"
                   <%= 'checked' if font[:id] == current_user.font %>
                   class="sr-only peer"
                   data-action="change->theme-preview#previewFont">
            <div class="rounded-lg border-2 p-4 transition-all duration-150
                        border-stroke hover:border-accent/60
                        peer-checked:border-accent peer-checked:bg-context-foreground
                        bg-background">
              <div class="flex items-center justify-between">
                <span class="text-xs text-gray-400 font-medium"><%= font[:name] %></span>
                <span class="text-base text-gray-100" style="font-family: <%= font[:stack] %>">AaBb 123</span>
              </div>
            </div>
          </label>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
