<% content_for :title, "Hourglass · Integrations" %>
<div class="flex-1 overflow-y-auto">
  <div class="max-w-3xl mx-auto p-4 sm:p-8">
    <div class="mb-8">
      <h1 class="text-2xl font-semibold text-gray-100 mb-1">Connect Hourglass</h1>
      <p class="text-sm text-gray-500">Connect Hourglass servers and choose which teams use each one. Teams that aren't connected to a server can't see its channels, and the server can't reach them.</p>
    </div>

    <% if flash[:notice] %>
      <div class="mb-4 px-3 py-2 rounded border border-accent/40 bg-accent/10 text-accent text-sm">
        <%= flash[:notice] %>
      </div>
    <% end %>
    <% if flash[:alert] %>
      <div class="mb-4 px-3 py-2 rounded border border-red-500/40 bg-red-500/10 text-red-300 text-sm">
        <%= flash[:alert] %>
      </div>
    <% end %>

    <% if @integrations.any? %>
      <div class="space-y-6 mb-8">
        <% @integrations.each do |integration| %>
          <%= render 'integration', integration: integration, workspace: @workspace, manageable_teams: @manageable_teams %>
        <% end %>
      </div>
    <% end %>

    <div class="rounded-lg border border-stroke bg-foreground p-5">
      <h2 class="text-lg font-medium text-gray-100 mb-1">
        <%= @integrations.any? ? 'Connect another server' : 'Connect a server' %>
      </h2>
      <p class="text-sm text-gray-500 mb-4">
        Pick the teams that should use this server. If the server is already connected, the teams are added to that connection.
      </p>
      <%= form_with url: workspace_settings_hourglass_integration_path(@workspace), method: :patch, class: 'space-y-4' do |f| %>
        <div>
          <%= f.label :base_url, 'Hourglass server URL', class: 'block text-sm font-medium text-gray-300 mb-1' %>
          <%= f.url_field :base_url, required: true, placeholder: 'https://hourglass.example.com',
                          class: 'w-full px-3 py-2 rounded-md border border-stroke bg-background text-gray-100 text-sm focus:outline-none focus:border-accent' %>
        </div>
        <div>
          <%= f.label :api_token, 'API token', class: 'block text-sm font-medium text-gray-300 mb-1' %>
          <%= f.password_field :api_token, required: true, autocomplete: 'off',
                               class: 'w-full px-3 py-2 rounded-md border border-stroke bg-background text-gray-100 text-sm focus:outline-none focus:border-accent' %>
          <p class="text-xs text-gray-500 mt-1">Generate a token in Hourglass under Settings → API tokens.</p>
        </div>
        <fieldset>
          <legend class="block text-sm font-medium text-gray-300 mb-1">Teams</legend>
          <% if @manageable_teams.any? %>
            <div class="space-y-1">
              <% @manageable_teams.each do |team| %>
                <label class="flex items-center gap-2 text-sm text-gray-200 cursor-pointer">
                  <%= check_box_tag 'team_ids[]', team.id, false, id: "team_ids_#{team.id}", class: 'cursor-pointer' %>
                  <%= team.name %> <span class="text-xs text-gray-500"><%= team.identifier %></span>
                </label>
              <% end %>
            </div>
          <% else %>
            <p class="text-xs text-gray-500">You don't manage any teams in this workspace.</p>
          <% end %>
        </fieldset>
        <div>
          <label class="flex items-center gap-2 text-sm text-gray-200 cursor-pointer">
            <%= check_box_tag :replace_credentials, '1', false, class: 'cursor-pointer' %>
            Replace stored credentials if this server is already connected
          </label>
          <p class="text-xs text-gray-500 mt-1">Leave unchecked to keep the existing connection's token and webhook secret and only add the teams.</p>
        </div>
        <div>
          <%= f.submit 'Connect', class: 'px-4 py-2 rounded-md bg-accent text-background hover:bg-accent-hover text-sm font-medium transition-colors cursor-pointer' %>
        </div>
      <% end %>
    </div>
  </div>
</div>
