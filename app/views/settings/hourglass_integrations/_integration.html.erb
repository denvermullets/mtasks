<%# locals: (integration:, workspace:, manageable_teams:) %>
<div class="rounded-lg border border-stroke bg-foreground p-5">
  <div class="flex items-center justify-between mb-3">
    <div>
      <div class="text-sm text-gray-400">Connected to</div>
      <div class="text-lg text-gray-100 font-medium"><%= integration.hourglass_server_name.presence || integration.hourglass_server_id %></div>
    </div>
    <span class="px-2 py-1 rounded text-xs bg-accent/10 text-accent border border-accent/40">Active</span>
  </div>
  <dl class="text-sm text-gray-400 space-y-1 mb-5">
    <div><dt class="inline">Server URL:</dt> <dd class="inline text-gray-200"><%= integration.base_url %></dd></div>
    <div><dt class="inline">Connected:</dt> <dd class="inline text-gray-200"><%= integration.connected_at&.to_fs(:long) || '—' %></dd></div>
    <div><dt class="inline">Last verified:</dt> <dd class="inline text-gray-200"><%= integration.last_verified_at&.to_fs(:long) || '—' %></dd></div>
  </dl>
  <div class="mb-5">
    <h3 class="text-sm font-medium text-gray-200 mb-2">Teams using this server</h3>
    <% subscribed = integration.subscribed_teams.sort_by(&:name) %>
    <% if subscribed.any? %>
      <ul class="space-y-1 mb-3">
        <% subscribed.each do |team| %>
          <li class="flex items-center justify-between text-sm">
            <span class="text-gray-200"><%= team.name %> <span class="text-xs text-gray-500"><%= team.identifier %></span></span>
            <% if manageable_teams.include?(team) %>
              <%= button_to 'Remove',
                            remove_team_workspace_settings_hourglass_integration_path(workspace, integration_id: integration.id, team_id: team.id),
                            method: :delete,
                            data: { turbo_confirm: "Remove #{team.name} from #{integration.hourglass_server_name || 'Hourglass'}? Its channel and thread links to this server will be marked broken." },
                            class: 'text-xs text-red-300 hover:text-red-200 cursor-pointer' %>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-xs text-gray-500 mb-3">No teams use this server yet.</p>
    <% end %>
    <% addable = manageable_teams.reject { |team| subscribed.include?(team) } %>
    <% if addable.any? %>
      <%= form_with url: add_team_workspace_settings_hourglass_integration_path(workspace), method: :post, class: 'flex items-center gap-2' do |f| %>
        <%= hidden_field_tag :integration_id, integration.id %>
        <%= f.select :team_id, addable.map { |team| [team.name, team.id] }, {},
                     class: 'px-3 py-1.5 rounded-md border border-stroke bg-background text-gray-100 text-sm focus:outline-none focus:border-accent' %>
        <%= f.submit 'Add team', class: 'px-3 py-1.5 rounded-md border border-stroke text-gray-200 hover:bg-background text-sm transition-colors cursor-pointer' %>
      <% end %>
    <% end %>
    <p class="text-xs text-gray-500 mt-2">After changing which teams use this server, re-verify the connection in Hourglass's settings so it picks up the new team list.</p>
  </div>

  <%= button_to 'Disconnect',
                workspace_settings_hourglass_integration_path(workspace, integration_id: integration.id),
                method: :delete,
                data: { turbo_confirm: "Disconnect from #{integration.hourglass_server_name || 'Hourglass'}?" },
                class: 'px-4 py-2 rounded-md border border-red-500/40 text-red-300 hover:bg-red-500/10 text-sm font-medium transition-colors cursor-pointer' %>

  <div class="mt-5 pt-5 border-t border-stroke">
    <h3 class="text-sm font-medium text-gray-200 mb-1">Hourglass-side configuration</h3>
    <p class="text-xs text-gray-500 mb-3">Paste these values into this server's webhook configuration so it knows where to deliver events.</p>
    <dl class="text-sm space-y-2">
      <div>
        <dt class="text-gray-400">Webhook URL</dt>
        <dd class="text-gray-200 font-mono break-all"><%= "#{request.protocol}#{request.host_with_port}/webhooks/hourglass/#{integration.workspace_id}" %></dd>
      </div>
      <div>
        <dt class="text-gray-400">Webhook secret</dt>
        <dd class="text-gray-200 font-mono break-all"><%= integration.webhook_secret %></dd>
      </div>
      <% if flash[:callback_token].present? && flash[:callback_token_integration_id].to_s == integration.id.to_s %>
        <div>
          <dt class="text-gray-400">Callback API token <span class="text-xs text-amber-300">(shown once)</span></dt>
          <dd class="text-gray-200 font-mono break-all"><%= flash[:callback_token] %></dd>
        </div>
      <% end %>
    </dl>
  </div>

  <div class="mt-5 pt-5 border-t border-stroke">
    <h3 class="text-sm font-medium text-gray-200 mb-1">Test webhook</h3>
    <p class="text-xs text-gray-500 mb-3">Send a signed sample event to <code class="text-gray-300"><%= "/webhooks/hourglass/#{integration.workspace_id}" %></code> to verify end-to-end delivery.</p>
    <%= form_with url: test_webhook_workspace_settings_hourglass_integration_path(workspace), method: :post, class: 'space-y-3' do |f| %>
      <%= hidden_field_tag :integration_id, integration.id %>
      <div>
        <%= f.label :event_type, 'Event type', class: 'block text-sm font-medium text-gray-300 mb-1' %>
        <%= f.select :event_type,
                     options_for_select(%w[message.created message.updated message.deleted message.pinned message.unpinned channel.created channel.updated channel.deleted ping], 'message.created'),
                     {},
                     class: 'w-full px-3 py-2 rounded-md border border-stroke bg-background text-gray-100 text-sm focus:outline-none focus:border-accent' %>
      </div>
      <div>
        <%= f.label :body, 'Payload (JSON)', class: 'block text-sm font-medium text-gray-300 mb-1' %>
        <%= f.text_area :body, rows: 8,
                        value: '{ "version": 1, "message_id": "test1", "channel_id": "<channel-id>", "author_email": "you@example.com", "body": "hi" }',
                        class: 'w-full px-3 py-2 rounded-md border border-stroke bg-background text-gray-100 text-sm font-mono focus:outline-none focus:border-accent' %>
      </div>
      <div>
        <%= f.submit 'Send', class: 'px-4 py-2 rounded-md bg-accent text-background hover:bg-accent-hover text-sm font-medium transition-colors cursor-pointer' %>
      </div>
    <% end %>
  </div>
</div>
