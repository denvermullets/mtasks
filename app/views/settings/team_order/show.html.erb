<div class="flex-1 overflow-y-auto"
     data-controller="team-order"
     data-team-order-url-value="<%= settings_team_order_path %>">
  <div class="max-w-3xl mx-auto p-4 sm:p-8">
    <div class="mb-8">
      <h1 class="text-2xl font-semibold text-gray-100 mb-1">Team order</h1>
      <p class="text-sm text-gray-500">Drag to reorder the teams in your sidebar. Changes save automatically.</p>
    </div>

    <div class="mb-8">
      <div class="text-sm font-medium text-gray-300 mb-3">Teams you own</div>
      <% if @owned_teams.any? %>
        <div class="space-y-1" data-team-order-target="list" data-scope="owned">
          <% @owned_teams.each do |team| %>
            <%= render "settings/team_order/row", team: team %>
          <% end %>
        </div>
      <% else %>
        <p class="text-xs text-gray-500">You don't own any teams yet.</p>
      <% end %>
    </div>

    <% if @joined_teams.any? %>
      <div class="mb-8">
        <div class="text-sm font-medium text-gray-300 mb-3">Teams you've joined</div>
        <div class="space-y-1" data-team-order-target="list" data-scope="joined">
          <% @joined_teams.each do |team| %>
            <%= render "settings/team_order/row", team: team %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
