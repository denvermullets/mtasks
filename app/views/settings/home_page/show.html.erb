<% content_for :title, "Home Page · Settings" %>
<div class="flex-1 overflow-y-auto">
  <div class="max-w-3xl mx-auto p-4 sm:p-8">
    <div class="mb-8">
      <h1 class="text-2xl font-semibold text-gray-100 mb-1">Home page</h1>
      <p class="text-sm text-gray-500">
        Where you land when you sign in or open the app.
      </p>
    </div>

    <% if flash[:notice] %>
      <div class="mb-4 px-3 py-2 rounded border border-accent/40 bg-accent/10 text-accent text-sm">
        <%= flash[:notice] %>
      </div>
    <% end %>
    <% if flash[:alert] %>
      <div class="mb-4 px-3 py-2 rounded border border-red-500/40 bg-red-500/10 text-red-300 text-sm">
        <%= flash[:alert] %>
      </div>
    <% end %>

    <div class="rounded-lg border border-stroke bg-foreground p-5">
      <%= form_with url: settings_home_page_path, method: :patch, class: "space-y-4" do %>
        <% selected = if (dashboard = current_user.home_dashboard)
                        "dashboard:#{dashboard.id}"
                      elsif (team = current_user.home_team)
                        "team:#{team.id}"
                      else
                        ""
                      end %>
        <div>
          <div class="text-sm font-medium text-gray-300 mb-2">Issues board</div>
          <div class="space-y-1">
            <label class="flex items-center gap-3 px-3 py-2 rounded-md hover:bg-hover-highlight cursor-pointer">
              <%= radio_button_tag :home, "", selected == "", id: "home_default", class: "accent-accent cursor-pointer" %>
              <span class="text-sm text-gray-200">Last team you used</span>
            </label>
            <% @teams.each do |team| %>
              <label class="flex items-center gap-3 px-3 py-2 rounded-md hover:bg-hover-highlight cursor-pointer">
                <%= radio_button_tag :home, "team:#{team.id}", selected == "team:#{team.id}", id: "home_team_#{team.id}", class: "accent-accent cursor-pointer" %>
                <span class="text-sm text-gray-200"><%= team.name %></span>
              </label>
            <% end %>
          </div>
        </div>
        <div>
          <div class="text-sm font-medium text-gray-300 mb-2">Dashboards</div>
          <% if @dashboards.any? %>
            <div class="space-y-1">
              <% @dashboards.each do |dashboard| %>
                <label class="flex items-center gap-3 px-3 py-2 rounded-md hover:bg-hover-highlight cursor-pointer">
                  <%= radio_button_tag :home, "dashboard:#{dashboard.id}", selected == "dashboard:#{dashboard.id}", id: "home_dashboard_#{dashboard.id}", class: "accent-accent cursor-pointer" %>
                  <span class="text-sm text-gray-200"><%= dashboard.name %></span>
                </label>
              <% end %>
            </div>
          <% else %>
            <p class="text-xs text-gray-500">
              You don't have any dashboards yet. <%= link_to "Create one", dashboards_path, class: "text-accent hover:text-accent/80 cursor-pointer" %> to use it as your home page.
            </p>
          <% end %>
        </div>
        <%= submit_tag "Save", class: "px-4 py-2 rounded-md bg-accent text-background hover:bg-accent-hover text-sm font-medium transition-colors cursor-pointer" %>
      <% end %>
    </div>
  </div>
</div>
