<% content_for :title, "Time Zone · Settings" %>
<div class="flex-1 overflow-y-auto">
  <div class="max-w-3xl mx-auto p-4 sm:p-8">
    <div class="mb-8">
      <h1 class="text-2xl font-semibold text-gray-100 mb-1">Time zone</h1>
      <p class="text-sm text-gray-500">
        Used as the default for things scheduled by date, like recurring issues.
      </p>
    </div>

    <% if flash[:notice] %>
      <div class="mb-4 px-3 py-2 rounded border border-accent/40 bg-accent/10 text-accent text-sm">
        <%= flash[:notice] %>
      </div>
    <% end %>
    <% if flash[:alert] %>
      <div class="mb-4 px-3 py-2 rounded border border-red-500/40 bg-red-500/10 text-red-300 text-sm">
        <%= flash[:alert] %>
      </div>
    <% end %>

    <div class="rounded-lg border border-stroke bg-foreground p-5">
      <%= form_with url: settings_time_zone_path, method: :patch, class: "space-y-4" do %>
        <div>
          <%= label_tag :time_zone, "Time zone", class: "block text-sm font-medium text-gray-300 mb-1" %>
          <%= select_tag :time_zone,
                         time_zone_options_for_select(current_user.time_zone, ActiveSupport::TimeZone.us_zones),
                         class: "w-full px-3 py-2 rounded-md border border-stroke bg-background text-gray-100 text-sm focus:outline-none focus:border-accent" %>
          <p class="text-xs text-gray-500 mt-1">
            It's currently <%= Time.current.in_time_zone(current_user.time_zone).to_fs(:long) %> in this zone.
          </p>
        </div>
        <%= submit_tag "Save", class: "px-4 py-2 rounded-md bg-accent text-background hover:bg-accent-hover text-sm font-medium transition-colors cursor-pointer" %>
      <% end %>
    </div>
  </div>
</div>
