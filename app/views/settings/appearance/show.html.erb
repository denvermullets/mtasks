<% content_for :title, "Appearance · Settings" %>
<div class="flex-1 overflow-y-auto" data-controller="theme-preview">
  <div class="max-w-3xl mx-auto p-4 sm:p-8">
    <div class="mb-8">
      <h1 class="text-2xl font-semibold text-gray-100 mb-1">Appearance</h1>
      <p class="text-sm text-gray-500">Pick a theme. The change applies instantly and saves when you submit.</p>
    </div>

    <% if flash[:notice] %>
      <div class="mb-4 px-3 py-2 rounded border border-accent/40 bg-accent/10 text-accent text-sm">
        <%= flash[:notice] %>
      </div>
    <% end %>

    <%= form_with url: settings_appearance_path, method: :patch do |f| %>
      <div class="mb-6">
        <div class="text-sm font-medium text-gray-300 mb-3">Theme</div>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
          <% @themes.each do |theme| %>
            <label class="relative cursor-pointer group">
              <input type="radio"
                     name="theme"
                     value="<%= theme[:id] %>"
                     <%= 'checked' if theme[:id] == current_user.theme %>
                     class="sr-only peer"
                     data-action="change->theme-preview#preview">
              <div class="rounded-lg border-2 p-4 transition-all duration-150
                          border-stroke hover:border-accent/60
                          peer-checked:border-accent peer-checked:bg-context-foreground
                          bg-foreground">
                <div class="flex items-center justify-between mb-3">
                  <span class="text-xs text-gray-300 font-medium"><%= theme[:name] %></span>
                </div>
                <div class="flex gap-2">
                  <% theme[:colors].each do |color| %>
                    <div class="w-6 h-6 rounded-full border border-stroke shrink-0" style="background-color: <%= color %>"></div>
                  <% end %>
                </div>
              </div>
            </label>
          <% end %>
        </div>
      </div>

      <div class="flex items-center gap-3">
        <%= f.submit "Save theme", class: "px-4 py-2 rounded-md bg-accent text-background hover:bg-accent-hover text-sm font-medium transition-colors cursor-pointer" %>
        <%= link_to "Cancel", settings_appearance_path, class: "px-4 py-2 rounded-md text-sm text-gray-400 hover:text-gray-200" %>
      </div>
    <% end %>
  </div>
</div>
