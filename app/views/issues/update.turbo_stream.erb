<%# Replace only the individual issue card — the optimistic UI already moved it to the right lane %>
<%= turbo_stream.replace "issue_#{@issue.id}",
    partial: "issues/issue_card",
    locals: { issue: @issue, visible_properties: @visible_properties } %>

<%# Update the sidebar if it's open %>
<%= turbo_stream.replace "issue_sidebar", partial: "issues/sidebar", locals: {
  issue: @issue,
  lanes: @lanes,
  team_members: @team_members,
  projects: @projects,
  labels: @labels,
  milestones: @milestones
} %>

<%# Append activity entry if on the issue detail page %>
<% if @latest_version&.event == 'update' %>
  <%= turbo_stream.append "activity_list", partial: "issues/activity_entry", locals: { version: @latest_version } %>
<% end %>

<%# Project chart and issues list are updated asynchronously via ProjectVelocityJob broadcast %>
