<div class="flex-1 flex flex-col min-h-0 bg-background">
  <!-- Top Bar -->
  <div class="h-14 bg-menu border-b border-stroke flex items-center justify-between px-4">
    <div class="flex items-center gap-4">
      <%= render "shared/mobile_menu_button" %>
      <%= link_to team_issue_path(current_team, @issue), class: "text-sm text-gray-500 hover:text-gray-400 flex items-center gap-2" do %>
        <span>&#8592;</span>
        <span class="hidden sm:inline"><%= current_team.name %></span>
        <span class="sm:hidden">Back</span>
      <% end %>
      <span class="text-gray-600 hidden sm:inline">&#8250;</span>
      <span class="text-sm text-gray-400 hidden sm:inline">Edit issue</span>
    </div>
  </div>
  <!-- Form Content -->
  <div class="flex-1 overflow-y-auto p-8">
    <div class="max-w-4xl mx-auto">
      <%= form_with model: [@issue.team, @issue], data: { controller: "issue-form submit-on-cmd-enter", turbo: false } do |form| %>
        <!-- Team Display (Read-only) -->
        <div class="mb-6 flex items-center gap-2">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-md bg-foreground border border-stroke text-gray-300 text-sm font-medium">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z"></path>
            </svg>
            <%= @issue.identifier %>
          </div>
        </div>
        <!-- Issue Title -->
        <div class="mb-6">
          <%= form.text_field :title,
              placeholder: "Issue title",
              autofocus: true,
              required: true,
              autocomplete: "off",
              class: "w-full bg-transparent border-0 text-gray-200 text-2xl font-semibold placeholder-gray-600 focus:outline-none focus:ring-0 p-0 #{'border-b-2 border-red-500' if @issue.errors[:title].any?}" %>
          <% if @issue.errors[:title].any? %>
            <div class="text-red-400 text-sm mt-2">
              <%= @issue.errors[:title].first %>
            </div>
          <% end %>
        </div>
        <!-- Description -->
        <div class="mb-6 relative"
             data-controller="issue-mention user-mention"
             data-issue-mention-search-url-value="<%= search_team_issues_path(@issue.team) %>"
             data-issue-mention-team-identifier-value="<%= @issue.team.identifier %>"
             data-user-mention-search-url-value="<%= search_team_members_path(@issue.team) %>">
          <%= form.text_area :description,
              placeholder: "Add description...",
              rows: 4,
              autocomplete: "off",
              class: "w-full bg-transparent border-0 text-gray-300 placeholder-gray-600 focus:outline-none focus:ring-0 p-0 resize-none overflow-hidden",
              data: { controller: "auto-resize", action: "input->auto-resize#resize keydown->submit-on-cmd-enter#submit input->issue-mention#onInput keydown->issue-mention#onKeydown paste->issue-mention#onPaste input->user-mention#onInput keydown->user-mention#onKeydown", issue_mention_target: "textarea", user_mention_target: "textarea" } %>
          <%= render "issue_mentions/dropdown" %>
          <%= render "user_mentions/dropdown" %>
        </div>
        <!-- Property Buttons -->
        <div class="flex flex-wrap gap-2 mb-8">
          <!-- Lane (Backlog) -->
          <div class="relative">
            <button type="button"
                    data-action="click->issue-form#toggleDropdown"
              data-dropdown="lane"
              class="inline-flex items-center gap-2 px-3 py-1.5 rounded-md bg-foreground border border-stroke text-gray-300 text-sm hover:bg-hover-highlight transition-colors">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"></path>
              </svg>
              <span data-issue-form-target="laneLabel">
                <%= @issue.lane&.name || @lanes.first&.name || "Backlog" %>
              </span>
            </button>
            <div data-issue-form-target="laneDropdown" class="hidden absolute top-full left-0 mt-1 min-w-[200px] bg-foreground border border-stroke rounded-md shadow-lg z-10">
              <% @lanes.each do |lane| %>
                <button type="button"
                        data-action="click->issue-form#selectLane"
                  data-lane-id="<%= lane.id %>"
                  data-lane-name="<%= lane.name %>"
                  class="w-full text-left px-3 py-2 text-sm text-gray-300 hover:bg-hover-highlight transition-colors first:rounded-t-md last:rounded-b-md">
                  <%= lane.name %>
                </button>
              <% end %>
            </div>
            <%= form.hidden_field :lane_id, value: @issue.lane_id || @lanes.first&.id, data: { issue_form_target: "laneInput" } %>
          </div>
          <!-- Priority -->
          <div class="relative">
            <button type="button"
                    data-action="click->issue-form#toggleDropdown"
              data-dropdown="priority"
              class="inline-flex items-center gap-2 px-3 py-1.5 rounded-md bg-foreground border border-stroke text-gray-300 text-sm hover:bg-hover-highlight transition-colors">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6h18M3 12h18M3 18h18"></path>
              </svg>
              <span data-issue-form-target="priorityLabel">
                <%= @issue.priority&.humanize || "No priority" %>
              </span>
            </button>
            <div data-issue-form-target="priorityDropdown" class="hidden absolute top-full left-0 mt-1 min-w-[200px] bg-foreground border border-stroke rounded-md shadow-lg z-10">
              <% [["No priority", "no_priority"], ["Urgent", "urgent"], ["High", "high"], ["Medium", "medium"], ["Low", "low"]].each do |label, value| %>
                <button type="button"
                        data-action="click->issue-form#selectPriority"
                  data-priority-value="<%= value %>"
                  data-priority-label="<%= label %>"
                  class="w-full text-left px-3 py-2 text-sm text-gray-300 hover:bg-hover-highlight transition-colors first:rounded-t-md last:rounded-b-md">
                  <%= label %>
                </button>
              <% end %>
            </div>
            <%= form.hidden_field :priority, value: @issue.priority || "no_priority", data: { issue_form_target: "priorityInput" } %>
          </div>
          <!-- Assignee -->
          <div class="relative">
            <button type="button"
                    data-action="click->issue-form#toggleDropdown"
              data-dropdown="assignee"
              class="inline-flex items-center gap-2 px-3 py-1.5 rounded-md bg-foreground border border-stroke text-gray-300 text-sm hover:bg-hover-highlight transition-colors">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
              </svg>
              <span data-issue-form-target="assigneeLabel">
                <%= @issue.assignee&.name || "No assignee" %>
              </span>
            </button>
            <div data-issue-form-target="assigneeDropdown" class="hidden absolute top-full left-0 mt-1 min-w-[200px] bg-foreground border border-stroke rounded-md shadow-lg z-10">
              <button type="button"
                      data-action="click->issue-form#selectAssignee"
                data-assignee-id
                data-assignee-name="No assignee"
                class="w-full text-left px-3 py-2 text-sm text-gray-300 hover:bg-hover-highlight transition-colors first:rounded-t-md">
                No assignee
              </button>
              <% @team_members.each do |member| %>
                <button type="button"
                        data-action="click->issue-form#selectAssignee"
                  data-assignee-id="<%= member.id %>"
                  data-assignee-name="<%= member.name %>"
                  class="w-full text-left px-3 py-2 text-sm text-gray-300 hover:bg-hover-highlight transition-colors last:rounded-b-md">
                  <%= member.name %>
                </button>
              <% end %>
            </div>
            <%= form.hidden_field :assignee_id, value: @issue.assignee_id || "", data: { issue_form_target: "assigneeInput" } %>
          </div>
          <!-- Project -->
          <div class="relative">
            <button type="button"
                    data-action="click->issue-form#toggleDropdown"
              data-dropdown="project"
              class="inline-flex items-center gap-2 px-3 py-1.5 rounded-md bg-foreground border border-stroke text-gray-300 text-sm hover:bg-hover-highlight transition-colors">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
              </svg>
              <span data-issue-form-target="projectLabel">
                <%= @issue.project&.name || "No project" %>
              </span>
            </button>
            <div data-issue-form-target="projectDropdown" class="hidden absolute top-full left-0 mt-1 min-w-[200px] bg-foreground border border-stroke rounded-md shadow-lg z-10">
              <button type="button"
                      data-action="click->issue-form#selectProject"
                data-project-id
                data-project-name="No project"
                class="w-full text-left px-3 py-2 text-sm text-gray-300 hover:bg-hover-highlight transition-colors first:rounded-t-md">
                No project
              </button>
              <% @projects.each do |project| %>
                <button type="button"
                        data-action="click->issue-form#selectProject"
                  data-project-id="<%= project.id %>"
                  data-project-name="<%= project.name %>"
                  class="w-full text-left px-3 py-2 text-sm text-gray-300 hover:bg-hover-highlight transition-colors last:rounded-b-md">
                  <%= project.name %>
                </button>
              <% end %>
            </div>
            <%= form.hidden_field :project_id, value: @issue.project_id || "", data: { issue_form_target: "projectInput" } %>
          </div>
          <!-- Estimate -->
          <div class="relative">
            <button type="button"
                    data-action="click->issue-form#toggleDropdown"
              data-dropdown="estimate"
              class="inline-flex items-center gap-2 px-3 py-1.5 rounded-md bg-foreground border border-stroke text-gray-300 text-sm hover:bg-hover-highlight transition-colors">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
              </svg>
              <span data-issue-form-target="estimateLabel">
                <%= @issue.estimate ? "#{@issue.estimate} #{'point'.pluralize(@issue.estimate)}" : "No estimate" %>
              </span>
            </button>
            <div data-issue-form-target="estimateDropdown" class="hidden absolute top-full left-0 mt-1 min-w-[200px] bg-foreground border border-stroke rounded-md shadow-lg z-10">
              <button type="button"
                      data-action="click->issue-form#selectEstimate"
                data-estimate-value
                data-estimate-label="No estimate"
                class="w-full text-left px-3 py-2 text-sm text-gray-300 hover:bg-hover-highlight transition-colors first:rounded-t-md">
                No estimate
              </button>
              <% [1, 2, 3, 5, 8, 13].each do |points| %>
                <button type="button"
                        data-action="click->issue-form#selectEstimate"
                  data-estimate-value="<%= points %>"
                  data-estimate-label="<%= points %> <%= 'point'.pluralize(points) %>"
                  class="w-full text-left px-3 py-2 text-sm text-gray-300 hover:bg-hover-highlight transition-colors last:rounded-b-md">
                  <%= points %> <%= 'point'.pluralize(points) %>
                </button>
              <% end %>
            </div>
            <%= form.hidden_field :estimate, value: @issue.estimate || "", data: { issue_form_target: "estimateInput" } %>
          </div>
          <!-- Labels -->
          <div class="relative">
            <button type="button"
                    data-action="click->issue-form#toggleLabelsDropdown"
              class="inline-flex items-center gap-2 px-3 py-1.5 rounded-md bg-foreground border border-stroke text-gray-300 text-sm hover:bg-hover-highlight transition-colors">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
              </svg>
              <span data-issue-form-target="labelsLabel">
                <% if @issue.labels.any? %>
                  <%= @issue.labels.count %> label<%= 's' if @issue.labels.count > 1 %>
                <% else %>
                  Labels
                <% end %>
              </span>
            </button>
            <%= render "labels/new_issue_picker", team_id: @issue.team_id, labels: @labels, selected_label_ids: @issue.label_ids %>
          </div>
        </div>
        <!-- Existing Attachments -->
        <% if @issue.files.attached? %>
          <div class="mb-8">
            <h3 class="text-sm font-medium text-gray-400 mb-3">Attachments</h3>
            <div class="space-y-2">
              <% @issue.files.each do |file| %>
                <div class="flex items-center justify-between px-3 py-2 bg-foreground border border-stroke rounded-md text-sm">
                  <div class="flex items-center gap-2 text-gray-300 min-w-0">
                    <% if file.image? %>
                      <span class="text-gray-500 shrink-0">&#128444;</span>
                    <% elsif file.content_type == "application/pdf" %>
                      <span class="text-gray-500 shrink-0">&#128196;</span>
                    <% else %>
                      <span class="text-gray-500 shrink-0">&#128206;</span>
                    <% end %>
                    <%= link_to file.filename, rails_blob_path(file, disposition: "attachment"),
                        class: "text-accent hover:text-accent-hover truncate" %>
                    <span class="text-gray-500 shrink-0"><%= number_to_human_size(file.byte_size) %></span>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>

        <!-- Add Files -->
        <div class="mb-8" data-controller="file-upload">
          <div data-action="dragover->file-upload#dragOver dragenter->file-upload#dragEnter dragleave->file-upload#dragLeave drop->file-upload#drop"
               class="border-2 border-dashed border-stroke rounded-lg p-6 text-center hover:border-accent/50 transition-colors">
            <svg class="w-8 h-8 mx-auto mb-2 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path>
            </svg>
            <p class="text-sm text-gray-400 mb-2">Drag and drop files here, or</p>
            <%= form.file_field :files, multiple: true,
                data: { file_upload_target: "input", action: "change->file-upload#handleFiles" },
                class: "hidden" %>
            <button type="button"
                    data-action="click->file-upload#openFilePicker"
                    class="px-3 py-1.5 text-sm bg-foreground border border-stroke rounded-md text-gray-300 hover:bg-hover-highlight transition-colors">
              Browse files
            </button>
            <p class="text-xs text-gray-500 mt-2">Images, PDFs, Markdown, and other files</p>
          </div>
          <div data-file-upload-target="fileList" class="mt-3 space-y-2"></div>
        </div>

        <!-- Bottom Actions -->
        <div class="flex items-center justify-end pt-6 border-t border-stroke">
          <div class="flex items-center gap-4">
            <%= link_to "Cancel", team_issue_path(@issue.team, @issue), class: "px-4 py-2 text-gray-400 hover:text-gray-300" %>
            <%= form.submit "Update issue",
                class: "px-4 py-2 rounded-md border-accent border hover:bg-accent hover:text-gray-800 text-accent font-medium cursor-pointer transition-colors" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
