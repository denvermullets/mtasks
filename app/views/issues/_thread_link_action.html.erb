<%# locals: (issue:, issue_thread_link:) %>
<% if issue_thread_link.nil? %>
  <%= link_to new_team_issue_hourglass_thread_link_path(issue.team, issue),
      data: { turbo_frame: "hourglass_thread_link_modal" },
      class: "inline-flex items-center gap-1 text-[11px] px-2 py-1 rounded border border-stroke text-gray-500 hover:text-gray-200 hover:bg-hover-highlight transition-colors" do %>
    <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/>
    </svg>
    Link Hourglass thread
  <% end %>
<% end %>
