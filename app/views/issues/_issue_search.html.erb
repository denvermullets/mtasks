<div class="relative" data-controller="issue-search">
  <svg class="w-4 h-4 absolute left-2.5 top-1/2 -translate-y-1/2 text-gray-500 pointer-events-none"
       fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
          d="M21 21l-4.35-4.35m0 0A7.5 7.5 0 1010.5 18a7.5 7.5 0 006.15-1.35z"></path>
  </svg>
  <input type="text"
         name="q"
         value="<%= params[:q] %>"
         placeholder="Search issues..."
         autocomplete="off"
         spellcheck="false"
         class="w-48 sm:w-56 pl-8 pr-3 py-1.5 text-xs font-medium rounded bg-foreground text-gray-200 placeholder-gray-500 border border-stroke focus:outline-none focus:border-accent transition-colors"
         data-issue-search-target="input"
         data-action="input->issue-search#onInput keydown.esc->issue-search#onEscape">
</div>
