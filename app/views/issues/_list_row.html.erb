<%# List view row - maintains table column structure %>
<div id="issue_row_<%= issue.id %>"
     class="relative border-b border-stroke hover:bg-hover-highlight transition-colors"
     data-controller="issue-card"
     data-issue-id="<%= issue.id %>">
  <%= link_to team_issue_path(issue.team, issue),
      data: {
        turbo_frame: "_top",
        action: "mouseenter->issue-card#mouseEnter mouseleave->issue-card#mouseLeave"
      },
      class: "block px-4 py-3 text-sm" do %>
  <div class="flex items-center gap-4">
    <!-- ID (fixed width) -->
    <div class="w-24 text-gray-400 font-mono shrink-0 flex items-center gap-1.5">
      <%= issue.identifier %>
      <% if issue.blocking_dependencies.any? || issue.blocked_dependencies.any? %>
        <span class="inline-flex items-center" title="<%= [issue.blocking_dependencies.any? ? "Blocking #{issue.blocking_dependencies.size}" : nil, issue.blocked_dependencies.any? ? "Blocked by #{issue.blocked_dependencies.size}" : nil].compact.join(' · ') %>">
          <svg class="w-3 h-3 <%= issue.blocked_dependencies.any? ? 'text-red-400' : 'text-yellow-400' %>" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"></path>
          </svg>
        </span>
      <% end %>
    </div>

    <!-- Title (flexible, takes available space) -->
    <div class="flex-1 text-gray-200 truncate"><%= issue.title %></div>

    <!-- Properties (right-aligned, flows naturally) -->
    <div class="flex items-center gap-2 shrink-0">
      <% if display_options[:visible_properties].include?('priority') && !issue.no_priority? %>
        <span class="text-xs text-gray-400"><%= issue.priority.titleize %></span>
      <% end %>

      <% if display_options[:visible_properties].include?('assignee') && issue.assignee %>
        <div class="flex items-center gap-1.5">
          <%= user_avatar(issue.assignee, size: "sm") %>
          <span class="text-xs text-gray-300"><%= issue.assignee.name %></span>
        </div>
      <% end %>

      <% if display_options[:visible_properties].include?('project') && issue.project %>
        <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded bg-foreground border border-stroke text-gray-400 text-xs">
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
          </svg>
          <%= issue.project.name %>
        </span>
      <% end %>

      <% if display_options[:visible_properties].include?('due_date') && issue.due_date %>
        <span class="text-xs text-gray-400"><%= issue.due_date.strftime('%b %d') %></span>
      <% end %>

      <% if display_options[:visible_properties].include?('labels') && issue.labels.any? %>
        <div class="flex items-center gap-1">
          <% visible_labels = issue.labels.first(2) %>
          <% remaining_count = issue.labels.count - visible_labels.count %>

          <% visible_labels.each do |label| %>
            <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-xs font-medium bg-foreground border border-stroke text-gray-400">
              <span class="w-1.5 h-1.5 rounded-full" style="background-color: <%= label.color %>;"></span>
              <%= label.name %>
            </span>
          <% end %>

          <% if remaining_count > 0 %>
            <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-xs font-medium bg-foreground border border-stroke text-gray-400">
              <span class="flex items-center gap-0.5">
                <% issue.labels[2...5].each do |label| %>
                  <span class="w-1.5 h-1.5 rounded-full" style="background-color: <%= label.color %>;"></span>
                <% end %>
              </span>
              +<%= remaining_count %>
            </span>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
  <% end %>

  <!-- Label Picker (for 'L' keyboard shortcut) -->
  <div>
    <%= render "labels/picker", issue: issue, labels: labels, context: "card" %>
  </div>

  <!-- Milestone Picker (for 'M' keyboard shortcut) -->
  <div>
    <%= render "milestones/picker", issue: issue, context: "card" %>
  </div>

  <!-- Lane Picker (for 'S' keyboard shortcut) -->
  <div>
    <%= render "lanes/picker", issue: issue, lanes: issue.team.lanes, context: "card" %>
  </div>

  <!-- Project Picker (for 'P' keyboard shortcut) -->
  <div>
    <%= render "projects/picker", issue: issue, projects: issue.team.projects, context: "card" %>
  </div>
</div>
