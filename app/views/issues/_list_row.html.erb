<%# List view row - maintains table column structure %>
<%
  visible_properties = display_options[:visible_properties]
  group_by = display_options[:group_by]
  show_status_pill = visible_properties.include?('status') && issue.lane && group_by != 'status'
  pr_summary = visible_properties.include?('pull_requests_and_commits') ? issue_pr_summary(issue) : nil
  time_in_status = visible_properties.include?('time_in_status') ? format_time_in_status(issue) : nil
  thread_count = local_assigns[:thread_count]
%>
<div id="issue_row_<%= issue.id %>"
     class="relative border-b border-stroke hover:bg-hover-highlight transition-colors"
     data-controller="issue-card"
     data-issue-id="<%= issue.id %>">
  <%= link_to team_issue_path(issue.team, issue),
      data: {
        turbo_frame: "_top",
        action: "mouseenter->issue-card#mouseEnter mouseleave->issue-card#mouseLeave"
      },
      class: "block px-4 py-3 text-sm" do %>
  <div class="flex items-center gap-4">
    <% if visible_properties.include?('id') %>
      <div class="w-24 text-gray-400 font-mono shrink-0 flex items-center gap-1.5">
        <%= issue.identifier %>
        <% if issue.blocking_dependencies.any? || issue.blocked_dependencies.any? %>
          <span class="inline-flex items-center" title="<%= [issue.blocking_dependencies.any? ? "Blocking #{issue.blocking_dependencies.size}" : nil, issue.blocked_dependencies.any? ? "Blocked by #{issue.blocked_dependencies.size}" : nil].compact.join(' · ') %>">
            <svg class="w-3 h-3 <%= issue.blocked_dependencies.any? ? 'text-red-400' : 'text-yellow-400' %>" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"></path>
            </svg>
          </span>
        <% end %>
      </div>
    <% end %>

    <!-- Title (flexible, takes available space) -->
    <div class="flex-1 text-gray-200 truncate flex items-center gap-2">
      <%= issue.title %>
      <% if issue.comments.size > 0 %>
        <span class="inline-flex items-center gap-0.5 text-xs text-gray-500 shrink-0" title="<%= pluralize(issue.comments.size, 'comment') %>">
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
          </svg>
          <%= issue.comments.size %>
        </span>
      <% end %>
      <% if thread_count && thread_count[:link_id] %>
        <span class="inline-flex items-center gap-0.5 text-xs text-gray-500 shrink-0" title="<%= pluralize(thread_count[:total], 'thread message') %>">
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M7 8h10M7 12h6m-6 8l-3-3h13a3 3 0 003-3V7a3 3 0 00-3-3H7a3 3 0 00-3 3v13z"></path>
          </svg>
          <% if thread_count[:total] > 0 %><%= thread_count[:total] %><% end %>
        </span>
        <% if thread_count[:unread] > 0 %>
          <span class="inline-flex items-center justify-center min-w-[1rem] h-4 px-1 rounded-full text-[10px] font-medium bg-accent text-gray-900 shrink-0" title="<%= pluralize(thread_count[:unread], 'unread message') %>">
            <%= thread_count[:unread] %>
          </span>
        <% end %>
      <% end %>
    </div>

    <!-- Properties (right-aligned, flows naturally) -->
    <div class="flex items-center gap-2 shrink-0">
      <% if show_status_pill %>
        <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded bg-foreground border border-stroke text-gray-400 text-xs">
          <span class="w-1.5 h-1.5 rounded-full" style="background-color: <%= issue.lane.color.presence || '#666' %>;"></span>
          <%= issue.lane.name %>
        </span>
      <% end %>

      <% if visible_properties.include?('priority') && !issue.no_priority? %>
        <span class="text-xs text-gray-400"><%= issue.priority.titleize %></span>
      <% end %>

      <% if visible_properties.include?('assignee') && issue.assignee %>
        <div class="flex items-center gap-1.5">
          <%= user_avatar(issue.assignee, size: "sm") %>
          <span class="text-xs text-gray-300"><%= issue.assignee.name %></span>
        </div>
      <% end %>

      <% if visible_properties.include?('project') && issue.project %>
        <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded bg-foreground border border-stroke text-gray-400 text-xs">
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
          </svg>
          <%= issue.project.name %>
        </span>
      <% end %>

      <% if visible_properties.include?('estimate') && issue.estimate %>
        <span class="text-xs text-gray-400"><%= issue.estimate %>pt</span>
      <% end %>

      <% if visible_properties.include?('due_date') && issue.due_date %>
        <span class="text-xs text-gray-400"><%= issue.due_date.strftime('%b %d') %></span>
      <% end %>

      <% if time_in_status %>
        <span class="text-xs text-gray-400" title="Time in current status"><%= time_in_status %></span>
      <% end %>

      <% if visible_properties.include?('created_at') %>
        <span class="text-xs text-gray-400" title="Created <%= issue.created_at.strftime('%b %d, %Y %l:%M %p') %>">
          <%= issue.created_at.strftime('%b %d') %>
        </span>
      <% end %>

      <% if visible_properties.include?('updated_at') %>
        <span class="text-xs text-gray-400" title="Updated <%= issue.updated_at.strftime('%b %d, %Y %l:%M %p') %>">
          <%= issue.updated_at.strftime('%b %d') %>
        </span>
      <% end %>

      <% if pr_summary %>
        <span class="inline-flex items-center gap-1 text-xs <%= pr_summary[:color_class] %>" title="<%= pluralize(pr_summary[:count], 'pull request') %>">
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 7h8m0 0v8m0-8l-8 8M6 20a2 2 0 100-4 2 2 0 000 4zm12 0a2 2 0 100-4 2 2 0 000 4zM6 4a2 2 0 100 4 2 2 0 000-4z"></path>
          </svg>
          <%= pr_summary[:count] %>
        </span>
      <% end %>

      <% if visible_properties.include?('labels') && issue.labels.any? %>
        <div class="flex items-center gap-1">
          <% visible_labels = issue.labels.first(2) %>
          <% remaining_count = issue.labels.size - visible_labels.size %>

          <% visible_labels.each do |label| %>
            <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-xs font-medium bg-foreground border border-stroke text-gray-400">
              <span class="w-1.5 h-1.5 rounded-full" style="background-color: <%= label.color %>;"></span>
              <%= label.name %>
            </span>
          <% end %>

          <% if remaining_count > 0 %>
            <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-xs font-medium bg-foreground border border-stroke text-gray-400">
              <span class="flex items-center gap-0.5">
                <% issue.labels.drop(2).first(3).each do |label| %>
                  <span class="w-1.5 h-1.5 rounded-full" style="background-color: <%= label.color %>;"></span>
                <% end %>
              </span>
              +<%= remaining_count %>
            </span>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
  <% end %>

  <!-- Label Picker (for 'L' keyboard shortcut) -->
  <div>
    <%= render "labels/picker", issue: issue, labels: labels, context: "card" %>
  </div>

  <!-- Lane Picker (for 'S' keyboard shortcut) -->
  <div>
    <%= render "lanes/picker", issue: issue, lanes: @lanes || issue.team.lanes, context: "card" %>
  </div>

  <!-- Project Picker (for 'P' keyboard shortcut) -->
  <div>
    <%= render "projects/picker", issue: issue, projects: @projects || issue.team.projects, context: "card" %>
  </div>
</div>
