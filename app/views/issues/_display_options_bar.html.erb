<div class="relative inline-block" data-controller="display-options">
  <!-- Display Button -->
  <button type="button"
          class="flex items-center gap-2 px-3 py-1.5 text-xs font-medium rounded bg-foreground text-gray-300 hover:bg-hover-highlight border border-stroke transition-colors"
          data-action="click->display-options#togglePanel">
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"></path>
    </svg>
    <span>Display</span>
    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
    </svg>
  </button>

  <!-- Display Options Panel -->
  <div class="hidden absolute top-full right-0 mt-2 w-80 bg-foreground border border-stroke rounded-lg shadow-xl z-50"
       data-display-options-target="panel">
    <div class="p-4 space-y-4">
      <!-- Save Button -->
      <div class="pb-4 border-b border-stroke">
        <%= form_with url: team_display_preference_path(current_team), method: :patch, data: { turbo: false, action: "submit->display-options#savePreferences" } do |f| %>
          <%= f.hidden_field :view_mode, value: @display_options[:view_mode] %>
          <%= f.hidden_field :group_by, value: @display_options[:group_by] %>
          <%= f.hidden_field :sub_group_by, value: @display_options[:sub_group_by] %>
          <%= f.hidden_field :order_by, value: @display_options[:order_by] %>
          <%= f.hidden_field :show_sub_issues, value: @display_options[:show_sub_issues] %>
          <%= f.hidden_field :show_empty_groups, value: @display_options[:show_empty_groups] %>
          <%= f.hidden_field :show_empty_rows, value: @display_options[:show_empty_rows] %>
          <%= f.hidden_field :completed_filter, value: @display_options[:completed_filter] %>
          <% @display_options[:visible_properties].each do |prop| %>
            <%= f.hidden_field "visible_properties[]", value: prop, id: nil %>
          <% end %>
          <%= f.submit "Save as default", class: "w-full rounded-md px-3.5 py-2.5 border border-accent text-gray-200 hover:bg-accent hover:text-gray-800 font-medium cursor-pointer", data: { display_options_target: "saveButton" } %>
        <% end %>
      </div>
      <!-- View Mode Section -->
      <div>
        <div class="flex items-center gap-2 mb-2">
          <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path>
          </svg>
          <span class="text-xs font-medium text-gray-400">View Mode</span>
        </div>
        <div class="flex items-center gap-2 bg-background rounded-md p-1">
          <button type="button"
                  class="flex-1 px-3 py-2 text-xs font-medium text-center rounded transition-colors <%= @display_options[:view_mode] == 'board' ? 'bg-foreground text-gray-100 border border-stroke' : 'text-gray-400 hover:text-gray-200' %>"
                  data-action="click->display-options#setViewMode"
                  data-view-mode="board">
            <div class="flex items-center justify-center gap-1">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h4a1 1 0 011 1v7a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM14 5a1 1 0 011-1h4a1 1 0 011 1v7a1 1 0 01-1 1h-4a1 1 0 01-1-1V5z"></path>
              </svg>
              Board
            </div>
          </button>
          <button type="button"
                  class="flex-1 px-3 py-2 text-xs font-medium text-center rounded transition-colors <%= @display_options[:view_mode] == 'list' ? 'bg-foreground text-gray-100 border border-stroke' : 'text-gray-400 hover:text-gray-200' %>"
                  data-action="click->display-options#setViewMode"
                  data-view-mode="list">
            <div class="flex items-center justify-center gap-1">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"></path>
              </svg>
              List
            </div>
          </button>
        </div>
      </div>

      <!-- Grouping Section (label changes based on view mode) -->
      <div>
        <label class="flex items-center gap-2 text-sm font-medium text-gray-300 mb-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" data-display-options-target="groupingIcon">
            <% if @display_options[:view_mode] == 'board' %>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 4H5a2 2 0 00-2 2v4m6-6h6m-6 0v6m6-6v6m6-6a2 2 0 012 2v4M4 10v6a2 2 0 002 2h4m-6-8h6m0 8v6m0-6h6m0 6v6m0-6a2 2 0 012-2h4"></path>
            <% else %>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"></path>
            <% end %>
          </svg>
          <span data-display-options-target="groupingLabel"><%= @display_options[:view_mode] == 'board' ? 'Columns' : 'Grouping' %></span>
        </label>
        <%= render "panel_dropdown_selector",
            current: @display_options[:group_by].titleize.gsub('_', ' '),
            options: [
              { value: 'none', label: 'No grouping' },
              { value: 'status', label: 'Status' },
              { value: 'assignee', label: 'Assignee' },
              { value: 'project', label: 'Project' },
              { value: 'priority', label: 'Priority' },
              { value: 'label', label: 'Label' },
              { value: 'parent_issue', label: 'Parent issue' }
            ],
            param_name: 'group_by' %>
      </div>

      <!-- Rows (Sub-grouping) Section - Only shown in board view -->
      <div data-display-options-target="rowsSection" class="<%= 'hidden' unless @display_options[:view_mode] == 'board' %>">
        <label class="flex items-center gap-2 text-sm font-medium text-gray-300 mb-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"></path>
          </svg>
          Rows
        </label>
        <%= render "panel_dropdown_selector",
            current: @display_options[:sub_group_by]&.titleize || 'None',
            options: [
              { value: 'none', label: 'None' },
              { value: 'status', label: 'Status' },
              { value: 'priority', label: 'Priority' },
              { value: 'assignee', label: 'Assignee' },
              { value: 'project', label: 'Project' }
            ],
            param_name: 'sub_group_by' %>
      </div>

      <!-- Ordering Section -->
      <div>
        <label class="flex items-center gap-2 text-sm font-medium text-gray-300 mb-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4h13M3 8h9m-9 4h6m4 0l4-4m0 0l4 4m-4-4v12"></path>
          </svg>
          Ordering
        </label>
        <%= render "panel_dropdown_selector",
            current: @display_options[:order_by].titleize.gsub('_', ' '),
            options: [
              { value: 'manual', label: 'Manual' },
              { value: 'priority', label: 'Priority' },
              { value: 'due_date', label: 'Due date' },
              { value: 'created_at', label: 'Created' },
              { value: 'updated_at', label: 'Updated' }
            ],
            param_name: 'order_by' %>
      </div>

      <!-- Completed Filter Section -->
      <div>
        <label class="text-sm font-medium text-gray-300 mb-2 block">
          Completed issues
        </label>
        <%= render "panel_dropdown_selector",
            current: @display_options[:completed_filter]&.titleize&.gsub('_', ' ') || 'Hide completed',
            options: [
              { value: '', label: 'Hide completed' },
              { value: 'past_day', label: 'Past day' },
              { value: 'past_week', label: 'Past week' },
              { value: 'past_month', label: 'Past month' },
              { value: 'all_completed', label: 'All completed' }
            ],
            param_name: 'completed_filter' %>
      </div>

      <!-- Show Sub-issues Toggle -->
      <%= render "toggle_option",
          label: "Show sub-issues",
          param: 'show_sub_issues',
          checked: @display_options[:show_sub_issues] %>

      <!-- Board Options Section -->
      <div class="pt-4 border-t border-stroke">
        <h3 class="text-sm font-semibold text-gray-200 mb-3">Board options</h3>

        <div class="space-y-3">
          <%= render "toggle_option",
              label: "Show empty columns",
              param: 'show_empty_groups',
              checked: @display_options[:show_empty_groups] %>

          <%= render "toggle_option",
              label: "Show empty rows",
              param: 'show_empty_rows',
              checked: @display_options[:show_empty_rows] %>
        </div>
      </div>

      <!-- Display Properties Section -->
      <div>
        <label class="text-sm font-medium text-gray-300 mb-2 block">
          Display properties
        </label>
        <div class="flex flex-wrap gap-2">
          <% UserPreference::AVAILABLE_PROPERTIES.each do |property| %>
            <label class="cursor-pointer">
              <input type="checkbox"
                     class="peer sr-only"
                     value="<%= property %>"
                     <%= 'checked' if @display_options[:visible_properties].include?(property) %>
                     data-action="change->display-options#updateProperties">
              <span class="inline-block px-2.5 py-1.5 text-sm rounded border transition-colors peer-checked:bg-accent peer-checked:text-gray-900 peer-checked:border-accent bg-background text-gray-300 border-stroke hover:border-accent">
                <%= property.titleize.gsub('_', ' ') %>
              </span>
            </label>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
