<%
  visible_properties ||= UserPreference::AVAILABLE_PROPERTIES
  labels ||= issue.team.labels
%>
<div id="issue_<%= issue.id %>" class="relative" data-controller="issue-card" data-issue-id="<%= issue.id %>">
  <%= link_to team_issue_path(issue.team, issue), class: "block", data: { turbo_frame: "_top" } do %>
    <div class="group bg-foreground border border-stroke hover:bg-hover-highlight hover:border-stroke rounded px-3 py-2.5 cursor-pointer transition-colors"
         data-action="mouseenter->issue-card#mouseEnter mouseleave->issue-card#mouseLeave">
    <!-- Identifier (always shown at top) -->
    <div class="font-mono text-xs text-gray-500 font-medium mb-2 flex items-center gap-1.5">
      <%= issue.identifier %>
      <% if issue.blocking_dependencies.any? || issue.blocked_dependencies.any? %>
        <span class="inline-flex items-center" title="<%= [issue.blocking_dependencies.any? ? "Blocking #{issue.blocking_dependencies.size}" : nil, issue.blocked_dependencies.any? ? "Blocked by #{issue.blocked_dependencies.size}" : nil].compact.join(' · ') %>">
          <svg class="w-3 h-3 <%= issue.blocked_dependencies.any? ? 'text-red-400' : 'text-yellow-400' %>" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"></path>
          </svg>
        </span>
      <% end %>
      <% if issue.comments.size > 0 %>
        <span class="inline-flex items-center gap-0.5 text-gray-500 ml-auto" title="<%= pluralize(issue.comments.size, 'comment') %>">
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
          </svg>
          <%= issue.comments.size %>
        </span>
      <% end %>
    </div>

    <!-- Title -->
    <div class="text-sm text-gray-200 mb-3 line-clamp-2 leading-snug">
      <%= issue.title %>
    </div>

    <!-- Dynamic Properties Footer -->
    <%
      # Check if any badges will be shown
      has_badges = (visible_properties.include?('priority') && !issue.no_priority?) ||
                   (visible_properties.include?('labels') && issue.labels.any?) ||
                   (visible_properties.include?('due_date') && issue.due_date) ||
                   (visible_properties.include?('estimate') && issue.estimate) ||
                   (visible_properties.include?('project') && issue.project) ||
                   (visible_properties.include?('lane') && issue.lane) ||
                   (visible_properties.include?('assignee') && issue.assignee)
    %>
    <div class="flex items-start justify-between text-xs gap-1">
      <div class="flex items-center gap-1.5 flex-wrap max-h-[3.5rem] overflow-hidden">
        <% unless has_badges %>
          <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h.01M12 12h.01M19 12h.01M6 12a1 1 0 11-2 0 1 1 0 012 0zm7 0a1 1 0 11-2 0 1 1 0 012 0zm7 0a1 1 0 11-2 0 1 1 0 012 0z"></path>
          </svg>
        <% end %>

        <% if visible_properties.include?('priority') && !issue.no_priority? %>
          <div class="flex items-center gap-0.5 px-1.5 py-0.5 rounded bg-foreground border border-stroke">
            <svg class="w-3 h-3 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
            </svg>
            <span class="text-gray-400"><%= case issue.priority
              when 'urgent' then 4
              when 'high' then 3
              when 'medium' then 2
              when 'low' then 1
              else 0
              end %></span>
          </div>
        <% end %>

        <% if visible_properties.include?('labels') && issue.labels.any? %>
          <% issue.labels.first(2).each do |label| %>
            <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-xs font-medium bg-foreground border border-stroke text-gray-400">
              <span class="w-1.5 h-1.5 rounded-full" style="background-color: <%= label.color %>;"></span>
              <%= label.name %>
            </span>
          <% end %>
          <% if issue.labels.count > 2 %>
            <span class="text-xs text-gray-500 shrink-0">+<%= issue.labels.count - 2 %></span>
          <% end %>
        <% end %>

        <% if visible_properties.include?('due_date') && issue.due_date %>
          <span class="px-1.5 py-0.5 rounded bg-foreground border border-stroke text-gray-400">
            <%= issue.due_date.strftime('%b %d') %>
          </span>
        <% end %>

        <% if visible_properties.include?('estimate') && issue.estimate %>
          <span class="px-1.5 py-0.5 rounded bg-foreground border border-stroke text-gray-400">
            <%= issue.estimate %>pt
          </span>
        <% end %>

        <% if visible_properties.include?('project') && issue.project %>
          <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded bg-foreground border border-stroke text-gray-400">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
            </svg>
            <%= issue.project.name %>
          </span>
        <% end %>

        <% if visible_properties.include?('lane') && issue.lane %>
          <span class="px-1.5 py-0.5 rounded bg-foreground border border-stroke text-gray-400">
            <%= issue.lane.name %>
          </span>
        <% end %>
      </div>

      <% if visible_properties.include?('assignee') && issue.assignee %>
        <%= user_avatar(issue.assignee, size: "sm") %>
      <% end %>
    </div>
    </div>
  <% end %>

  <!-- Label Picker Overlay (for 'L' keyboard shortcut) -->
  <div>
    <%= render "labels/picker", issue: issue, labels: labels, context: "card" %>
  </div>

  <!-- Lane Picker Overlay (for 'S' keyboard shortcut) -->
  <div>
    <%= render "lanes/picker", issue: issue, lanes: issue.team.lanes, context: "card" %>
  </div>

  <!-- Project Picker Overlay (for 'P' keyboard shortcut) -->
  <div>
    <%= render "projects/picker", issue: issue, projects: issue.team.projects, context: "card" %>
  </div>
</div>
