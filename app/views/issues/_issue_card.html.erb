<%= link_to team_issue_path(issue.team, issue), class: "block" do %>
  <div class="group bg-foreground border border-stroke hover:bg-hover-highlight hover:border-stroke rounded px-2.5 py-2 cursor-pointer transition-colors"
       data-controller="issue-card"
       data-issue-id="<%= issue.id %>">
    <!-- Header: ID -->
    <div class="flex items-center justify-between mb-1.5">
      <span class="font-mono text-xs text-gray-500 font-medium">
        <%= issue.identifier %>
      </span>
    </div>
    <!-- Title -->
    <div class="text-sm text-gray-200 mb-auto line-clamp-2 leading-snug">
      <%= issue.title %>
    </div>
    <!-- Footer: Priority, Labels, and Estimate -->
    <div class="flex items-center justify-between text-xs mt-2">
      <div class="flex items-center gap-1.5">
        <!-- Priority Icon -->
        <% unless issue.no_priority? %>
          <div class="flex items-center gap-0.5 px-1.5 py-0.5 rounded bg-foreground border border-stroke">
            <svg class="w-3 h-3 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
            </svg>
            <span class="text-gray-400"><%= case issue.priority
              when 'urgent' then 4
              when 'high' then 3
              when 'medium' then 2
              when 'low' then 1
              else 0
              end %></span>
          </div>
        <% end %>
        <!-- Labels -->
        <% if issue.labels.any? %>
          <% issue.labels.first(2).each do |label| %>
            <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-xs font-medium bg-foreground border border-stroke text-gray-400">
              <span class="w-1.5 h-1.5 rounded-full" style="background-color: <%= label.color %>;"></span>
              <%= label.name %>
            </span>
          <% end %>
          <% if issue.labels.count > 2 %>
            <span class="text-xs text-gray-500">+<%= issue.labels.count - 2 %></span>
          <% end %>
        <% else %>
          <span class="text-xs text-gray-600">...</span>
        <% end %>
      </div>
      <!-- Assignee Avatar -->
      <% if issue.assignee %>
        <div class="w-5 h-5 rounded-full bg-blue-600 flex items-center justify-center text-white text-xs font-medium">
          <%= issue.assignee.name.first.upcase %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
