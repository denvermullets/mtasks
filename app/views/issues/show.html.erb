<div class="flex-1 flex flex-col min-h-0" data-controller="lightbox">
  <!-- Top Bar -->
  <div class="h-12 sm:h-14 bg-menu border-b border-stroke flex items-center justify-between px-3 sm:px-4">
    <div class="flex items-center gap-2 sm:gap-4 min-w-0">
      <%= render "shared/mobile_menu_button" %>
      <% back = back_nav_link(fallback_url: team_issues_path(current_team), fallback_label: 'Issues') %>
      <%= link_to back[:url],
          class: "text-sm text-gray-500 hover:text-gray-400 flex items-center gap-2" do %>
        <span>&#8592;</span>
        <span class="hidden sm:inline"><%= back[:label] %></span>
        <span class="sm:hidden">Back</span>
      <% end %>
      <span class="text-gray-600 hidden sm:inline">&#8250;</span>
      <span class="text-sm text-gray-400 font-mono truncate"><%= @issue.identifier %></span>
    </div>
    <div class="flex items-center gap-2">
      <%= render 'issues/thread_badge', issue: @issue, issue_thread_link: @issue_thread_link %>
      <% if Current.user.admin? || @issue.creator == Current.user %>
        <%= link_to "Edit", edit_team_issue_path(@issue.team, @issue), class: "px-3 py-1.5 text-xs font-medium rounded bg-gray-800 text-gray-300 hover:bg-gray-700" %>
      <% end %>
    </div>
  </div>
  <div class="flex-1 flex bg-background overflow-hidden min-h-0">
    <!-- Issue Detail Content -->
    <div class="flex-1 overflow-y-auto">
      <div class="max-w-4xl mx-auto p-4 sm:p-8">
        <!-- Issue Title -->
        <div class="mb-3 sm:mb-6">
          <h1 class="text-lg sm:text-2xl font-semibold text-gray-100 leading-tight">
            <%= @issue.title %>
          </h1>
        </div>
        <!-- Description -->
        <% if @issue.description.present? %>
          <div class="mb-6 sm:mb-8">
            <div class="markdown text-gray-300">
              <%= render_markdown(@issue.description, team: @issue.team) %>
            </div>
          </div>
        <% end %>
        <!-- Attachments -->
        <% if @issue.files.attached? %>
          <div class="mb-6 sm:mb-8">
            <h2 class="text-sm font-semibold text-gray-400 mb-4">Attachments</h2>
            <%= render "shared/attachments", files: @issue.files %>
          </div>
        <% end %>

        <!-- Sub-issues Section -->
        <% if @issue.sub_issues.any? %>
          <div class="mb-6 sm:mb-8">
            <button class="flex items-center gap-2 mb-4 text-sm text-gray-400 hover:text-gray-300">
              <span>&#9654;</span>
              <span>+ Add sub-issues</span>
            </button>
          </div>
        <% end %>

        <!-- Mobile Properties (inline, replaces the hidden drawer) -->
        <div class="sm:hidden border-t border-stroke -mx-4 px-0 mb-6">
          <%= render 'sidebar', issue: @issue, lanes: @lanes, team_members: @team_members, projects: @projects, labels: @labels, mobile: true %>
        </div>

        <!-- Discussion Section (populated when an Hourglass thread is linked) -->
        <%= render 'issues/discussion', issue: @issue, team: @issue.team, issue_thread_link: @issue_thread_link %>

        <!-- Activity Section -->
        <div class="border-t border-stroke pt-6 sm:pt-8">
          <div class="flex items-center justify-between mb-4 sm:mb-6">
            <h2 class="text-sm font-semibold text-gray-400">Activity</h2>
            <%= turbo_frame_tag "issue_thread_link_action_#{@issue.id}" do %>
              <%= render 'issues/thread_link_action', issue: @issue, issue_thread_link: @issue_thread_link %>
            <% end %>
          </div>
          <!-- Created entry -->
          <div class="mb-1">
            <div class="text-xs text-gray-500">
              <%= @issue.creator&.name || 'Unknown' %>
              created the issue &middot; <%= time_ago_in_words(@issue.created_at) %> ago
            </div>
          </div>
          <!-- Activity Timeline -->
          <div id="activity_list">
            <% VersionDescriptionService.timeline(@issue).each do |entry| %>
              <% next if entry[:type] == :comment && @issue_thread_link.present? %>
              <% if entry[:type] == :version %>
                <%= render 'issues/activity_entry', version: entry[:record] %>
              <% elsif entry[:type] == :reference %>
                <%= render 'issue_references/activity_entry', reference: entry[:record] %>
              <% else %>
                <%= render entry[:record] %>
              <% end %>
            <% end %>
          </div>
          <!-- Comment Form (visible only when no thread link; replaced via Turbo on link/unlink) -->
          <%= turbo_frame_tag "issue_native_comment_form_#{@issue.id}" do %>
            <%= render 'issues/native_comment_form', issue: @issue, issue_thread_link: @issue_thread_link %>
          <% end %>
        </div>
      </div>
    </div>
    <!-- Right Sidebar - Properties (Desktop) -->
    <div class="hidden sm:block">
      <%= render 'sidebar', issue: @issue, lanes: @lanes, team_members: @team_members, projects: @projects, labels: @labels %>
    </div>
  </div>

  <%= render "shared/lightbox" %>
  <%= turbo_frame_tag "hourglass_thread_link_modal" %>
</div>
<% content_for :head do %>
  <style>
    .prose {
      color: #d1d5db;
    }
    .prose p {
      margin-bottom: 1rem;
    }
  </style>
<% end %>
