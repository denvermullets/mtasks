<%# locals: (issue:, team:, issue_thread_link:) %>
<%= turbo_frame_tag "issue_discussion_#{issue.id}" do %>
  <% if issue_thread_link.nil? %>
    <%# Empty: the link affordance lives in the Activity heading. %>
  <% elsif issue_thread_link.broken? %>
    <div class="border-t border-stroke pt-6 sm:pt-8 mb-6 sm:mb-8"></div>
    <div class="border border-red-500/30 bg-red-500/5 rounded-lg p-6">
      <div class="flex items-start gap-3">
        <svg class="w-5 h-5 text-red-400 mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        <div class="flex-1">
          <h3 class="text-sm font-medium text-red-200 mb-1">Thread link is broken</h3>
          <p class="text-xs text-red-300/80 mb-4">
            We couldn't reach thread <span class="font-mono"><%= issue_thread_link.hourglass_thread_id %></span> on Hourglass.
            The thread may have been deleted or the integration token revoked.
          </p>
          <div class="flex items-center gap-2">
            <%= link_to new_team_issue_hourglass_thread_link_path(team, issue),
                data: { turbo_frame: "hourglass_thread_link_modal" },
                class: "px-2.5 py-1 rounded bg-red-500/20 border border-red-500/40 text-red-200 text-xs font-medium hover:bg-red-500/30 transition-colors" do %>
              Re-link thread
            <% end %>
            <%= button_to team_issue_hourglass_thread_link_path(team, issue),
                method: :delete,
                data: { turbo_frame: "_top" },
                class: "px-2.5 py-1 rounded border border-stroke text-gray-400 text-xs hover:text-gray-200 hover:bg-hover-highlight transition-colors" do %>
              Unlink
            <% end %>
          </div>
        </div>
      </div>
    </div>
  <% else %>
    <div class="border-t border-stroke pt-6 sm:pt-8 mb-6 sm:mb-8"></div>
    <div class="border border-stroke rounded-lg overflow-hidden" data-controller="discussion-filter">
      <div class="flex items-center justify-between px-4 py-3 border-b border-stroke bg-foreground">
        <div class="flex items-center gap-2 min-w-0">
          <h2 class="text-sm font-semibold text-gray-200">Discussion</h2>
          <span class="inline-flex items-center gap-1.5 text-[11px] text-gray-400">
            <svg class="w-3 h-3 text-gray-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/>
            </svg>
            linked to thread
            <span class="font-mono text-accent"><%= issue_thread_link.hourglass_thread_id %></span>
          </span>
        </div>
        <%= button_to team_issue_hourglass_thread_link_path(team, issue),
            method: :delete,
            form: { data: { turbo_confirm: 'Unlink this thread from the issue?' } },
            class: "px-2 py-1 rounded text-xs text-gray-500 hover:text-gray-200 hover:bg-hover-highlight transition-colors" do %>
          Unlink
        <% end %>
      </div>
      <div id="issue_discussion_flash_<%= issue.id %>" class="px-4 pt-3"></div>
      <%= turbo_stream_from "issue_#{issue.id}_discussion" %>
      <div id="issue_discussion_stream_<%= issue.id %>"
           data-discussion-filter-target="stream"
           class="divide-y divide-stroke/40 [&:has(article)>#issue_discussion_empty_<%= issue.id %>]:hidden">
        <% items = DiscussionStreamService.call(issue: issue, issue_thread_link: issue_thread_link) %>
        <div id="issue_discussion_empty_<%= issue.id %>" class="px-4 py-10 text-center text-xs text-gray-500 <%= 'hidden' if items.any? %>">
          No messages yet. Post a comment below or send a message in the linked thread.
        </div>
        <% items.each do |item| %>
          <% if item.kind == :hourglass %>
            <%= render "projects/discussion_message",
                       message: item.record,
                       team: team,
                       channel_link: issue_thread_link %>
          <% else %>
            <%= render "projects/discussion_native_comment",
                       comment: item.record,
                       team: team %>
          <% end %>
        <% end %>
      </div>
      <%= render "discussion/comments/composer",
                 team: team,
                 form_url: team_issue_discussion_comments_path(team, issue),
                 hint: "Toggle on to also post into the linked Hourglass thread.",
                 toggle_label: "Also send to thread" %>
    </div>
  <% end %>
<% end %>
