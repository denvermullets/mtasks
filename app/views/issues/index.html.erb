<div class="flex-1 flex flex-col min-h-0"
     data-controller="board-keyboard"
     data-board-keyboard-surface-value="<%= @display_options[:view_mode] == 'board' ? 'board' : 'list' %>">
  <!-- Top Bar -->
  <div class="bg-menu border-b border-stroke shrink-0">
    <div class="h-12 sm:h-14 flex items-center justify-between px-3 sm:px-4">
      <div class="flex items-center gap-3 sm:gap-4 min-w-0">
        <%= render "shared/mobile_menu_button" %>
        <h1 class="text-base font-semibold truncate"><%= current_team&.identifier %></h1>
        <span class="text-sm text-gray-500 hidden sm:inline"><%= current_team&.workspace&.name %></span>
      </div>
      <div class="hidden sm:flex items-center gap-2">
        <%= render "issue_search" %>
        <%= render "filter_menu" %>
        <%= turbo_frame_tag "display_options_bar" do %>
          <%= render "display_options_bar" %>
        <% end %>
        <%= link_to new_team_issue_path(current_team),
            data: { turbo_frame: "_top" },
            class: "flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded bg-accent text-gray-900 hover:opacity-90 transition-opacity" do %>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"></path>
          </svg>
          <span>New</span>
        <% end %>
      </div>
    </div>
    <!-- Mobile search row -->
    <div class="sm:hidden px-3 pb-2">
      <%= render "issue_search" %>
    </div>
    <!-- Active filter chips (server-rendered initial state, JS-updated on change) -->
    <%= render "active_filter_chips" %>
    <!-- Mobile group filter chips -->
    <%= render "mobile_group_chips", grouped_issues: @grouped_issues, display_options: @display_options %>
  </div>

  <!-- Board -->
  <%= turbo_frame_tag "issues_board", class: "flex-1 overflow-x-auto overflow-y-hidden bg-background min-h-0" do %>
    <%= render "issues_board" %>
  <% end %>

  <%# Shared pickers — one instance each for the whole board, retargeted per hovered card
      via the P / J / S / L shortcuts. Live outside #issues_board so they survive turbo-stream reloads. %>
  <%= render "projects/picker", issue: nil, shared: true, context: "card",
             team: current_team, projects: current_team.projects %>
  <%= render "issues/priority_picker", issue: nil, shared: true, context: "card",
             team: current_team %>
  <%= render "lanes/picker", issue: nil, shared: true, context: "card",
             team: current_team, lanes: current_team.lanes.order(:position) %>
  <%= render "labels/picker", issue: nil, shared: true, context: "card",
             team: current_team, labels: current_team.labels %>

  <!-- Mobile FAB for new issue -->
  <%= link_to new_team_issue_path(current_team),
      data: { turbo_frame: "_top" },
      class: "sm:hidden fixed bottom-5 right-4 w-12 h-12 rounded-full bg-accent text-gray-900 shadow-lg flex items-center justify-center z-30" do %>
    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"></path>
    </svg>
  <% end %>
</div>
