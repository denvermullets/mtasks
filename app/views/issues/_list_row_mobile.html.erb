<%# Mobile list row — matches .notes/refs/jait_mockups-mobile.jsx IssueRow %>
<% lane_color = issue.lane&.color.presence || '#666' %>
<% right_slot = mobile_row_right_slot(issue, display_options[:visible_properties]) %>
<div id="mobile_issue_row_<%= issue.id %>"
     class="border-b border-stroke"
     data-controller="issue-card"
     data-issue-id="<%= issue.id %>">
  <%= link_to team_issue_path(issue.team, issue),
      data: { turbo_frame: "_top" },
      class: "flex items-center gap-2.5 px-3.5 py-3" do %>
    <span class="w-1.5 h-1.5 rounded-full flex-shrink-0"
          style="background-color: <%= lane_color %>;"
          title="<%= issue.lane&.name %>"></span>
    <span class="text-[11px] text-gray-500 font-mono min-w-[48px] flex-shrink-0">
      <%= issue.identifier %>
    </span>
    <span class="text-sm flex-1 min-w-0 truncate text-gray-200">
      <%= issue.title %>
    </span>
    <% case right_slot %>
    <% when :priority %>
      <%= mobile_priority_tag(issue) %>
    <% when :assignee %>
      <span class="flex-shrink-0"><%= user_avatar(issue.assignee, size: "sm") %></span>
    <% when :labels %>
      <span class="flex items-center gap-0.5 flex-shrink-0">
        <% issue.labels.first(2).each do |label| %>
          <span class="w-1.5 h-1.5 rounded-full" style="background-color: <%= label.color %>;"></span>
        <% end %>
      </span>
    <% when :comments %>
      <span class="flex items-center gap-0.5 text-[11px] text-gray-500 flex-shrink-0">
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
        </svg>
        <%= issue.comments.size %>
      </span>
    <% end %>
  <% end %>
</div>
