<% swimlanes = organize_for_swimlanes(@grouped_issues) %>

<div class="flex h-full overflow-auto">
  <% if swimlanes.present? %>
    <!-- Swimlane Layout: Rows span horizontally across columns -->
    <div class="flex flex-col flex-1">
      <!-- Column Headers (sticky at top) -->
      <div class="flex gap-3 mb-4 sticky top-0 bg-background z-30 pb-2">
        <% first_row_columns = swimlanes.values.first %>
        <% first_row_columns.each do |column_name, col_data| %>
          <div class="shrink-0 w-80">
            <div class="flex items-center justify-between">
              <h3 class="text-sm font-medium text-accent"><%= column_name %></h3>
              <span class="text-xs text-gray-500" data-lane-count="<%= col_data[:object].id if col_data[:object].respond_to?(:id) %>" data-group-count="<%= group_value_for(col_data[:object]) %>">
                <%= swimlanes.sum { |_, cols| cols[column_name][:issues].count } %>
              </span>
            </div>
          </div>
        <% end %>
      </div>

      <!-- Swimlanes (Rows) -->
      <div class="flex flex-col gap-6">
        <% swimlanes.each do |row_name, columns| %>
          <% row_issue_count = columns.sum { |_, col_data| col_data[:issues].count } %>
          <% row_empty = row_issue_count.zero? %>
          <div id="swimlane_<%= row_name.parameterize %>" class="flex flex-col gap-2" data-controller="swimlane-row" data-swimlane-row-name="<%= row_name %>">
            <!-- Row Header (Swimlane) -->
            <div class="flex items-center gap-2 px-3 py-1.5 bg-hover-highlight rounded-md">
              <button type="button" data-action="swimlane-row#toggle" class="flex items-center gap-2 cursor-pointer">
                <svg data-swimlane-row-target="chevron" class="w-3 h-3 text-gray-500 transition-transform duration-200 <%= '-rotate-90' if row_empty %>" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                </svg>
                <h4 class="text-xs font-medium text-accent"><%= row_name %></h4>
              </button>
              <span class="text-xs text-gray-500" data-swimlane-row-count="<%= row_name %>"><%= row_issue_count %></span>
            </div>

            <!-- Columns within this row -->
            <div class="flex gap-3 <%= 'hidden' if row_empty %>" data-swimlane-row-target="content">
              <% columns.each do |column_name, column_data| %>
                <div class="shrink-0 w-80 flex flex-col group/cell" data-lane-id="<%= column_data[:object].id if column_data[:object].respond_to?(:id) %>">
                  <!-- Issues in this cell -->
                  <div class="space-y-1.5 min-h-[60px]" data-lane-issues-container="<%= column_data[:object].id if column_data[:object].respond_to?(:id) %>" data-group-container="<%= group_value_for(column_data[:object]) %>">
                    <% column_data[:issues].each do |issue| %>
                      <%= render "issue_card", issue: issue, visible_properties: @display_options[:visible_properties] %>
                    <% end %>
                  </div>

                  <!-- Add Issue Button -->
                  <%= link_to new_team_issue_path(current_team, lane_id: (column_data[:object].id if column_data[:object].respond_to?(:id))),
                      data: { turbo_frame: "_top" },
                      class: "opacity-0 group-hover/cell:opacity-100 transition-opacity flex items-center justify-center p-3 rounded-md border border-stroke hover:bg-hover-highlight mt-1.5" do %>
                    <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                    </svg>
                  <% end %>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Hidden Columns Section (swimlane view) -->
    <% if @empty_groups.present? %>
      <div class="shrink-0 w-64 flex flex-col h-full ml-3 pl-3 border-l border-stroke">
        <!-- Header -->
        <div class="flex items-center gap-2 mb-3 shrink-0 sticky top-0 bg-background z-30 pb-2">
          <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
          </svg>
          <h3 class="text-sm font-medium text-gray-500">Hidden columns</h3>
        </div>

        <!-- List of empty groups -->
        <div class="flex-1 overflow-y-auto min-h-0 space-y-2">
          <% @empty_groups.uniq { |g| g[:name] }.each do |empty_group| %>
            <div class="flex items-center gap-2 px-3 py-2 text-sm text-gray-400">
              <%= render_group_icon(empty_group[:object]) %>
              <span><%= empty_group[:name] %></span>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  <% else %>
    <!-- Standard Column Layout: No swimlanes -->
    <div class="flex gap-3 flex-1">
      <% @grouped_issues.each do |group_name, group_data| %>
        <div id="board_column_<%= group_name.parameterize %>" class="shrink-0 w-80 flex flex-col h-full group" data-lane-id="<%= group_data[:object].id if group_data[:object].respond_to?(:id) %>">
          <!-- Group Header -->
          <div class="flex items-center justify-between mb-3 shrink-0">
            <div class="flex items-center gap-2">
              <h3 class="text-sm font-medium text-accent"><%= group_name %></h3>
              <span class="text-xs text-gray-500" data-lane-count="<%= group_data[:object].id if group_data[:object].respond_to?(:id) %>" data-group-count="<%= group_value_for(group_data[:object]) %>"><%= group_data[:issues].count %></span>
            </div>
          </div>

          <!-- Issues -->
          <div class="flex-1 overflow-y-auto min-h-0">
            <div class="space-y-1.5" data-lane-issues-container="<%= group_data[:object].id if group_data[:object].respond_to?(:id) %>" data-group-container="<%= group_value_for(group_data[:object]) %>">
              <% group_data[:issues].each do |issue| %>
                <%= render "issue_card", issue: issue, visible_properties: @display_options[:visible_properties] %>
              <% end %>
            </div>

            <!-- Add Issue Button -->
            <%= link_to new_team_issue_path(current_team, lane_id: (group_data[:object].id if group_data[:object].respond_to?(:id))),
                data: { turbo_frame: "_top" },
                class: "opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center p-3 rounded-md border border-stroke hover:bg-hover-highlight mt-1.5" do %>
              <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
              </svg>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Hidden Columns Section -->
    <% if @empty_groups.present? %>
      <div class="shrink-0 w-64 flex flex-col h-full ml-3 pl-3 border-l border-stroke">
        <!-- Header -->
        <div class="flex items-center gap-2 mb-3 shrink-0">
          <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
          </svg>
          <h3 class="text-sm font-medium text-gray-500">Hidden columns</h3>
        </div>

        <!-- List of empty groups -->
        <div class="flex-1 overflow-y-auto min-h-0 space-y-2">
          <% @empty_groups.uniq { |g| g[:name] }.each do |empty_group| %>
            <div class="flex items-center gap-2 px-3 py-2 text-sm text-gray-400">
              <%= render_group_icon(empty_group[:object]) %>
              <span><%= empty_group[:name] %></span>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
