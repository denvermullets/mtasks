<div class="relative w-full">
  <select class="w-full px-3 py-2 text-sm bg-background text-gray-300 border border-stroke rounded focus:outline-none focus:border-accent transition-colors cursor-pointer"
          data-action="change->display-options#handleDropdownChange"
          data-param="<%= param_name %>">
    <% options.each do |option| %>
      <option value="<%= option[:value] %>" <%= 'selected' if current == option[:label] || (current.downcase == option[:value].to_s.gsub('_', ' ')) %>>
        <%= option[:label] %>
      </option>
    <% end %>
  </select>
</div>
