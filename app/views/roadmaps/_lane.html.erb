<%# locals: (commitment:, label:, subtitle:, border_color:, dot_color:, text_color:, projects:, projects_off_roadmap:, team:) %>
<div class="rounded-md border overflow-hidden" style="border-color: <%= border_color %>;">
  <!-- Lane header -->
  <div class="flex items-center justify-between px-3 py-2.5 bg-foreground">
    <div class="flex items-center gap-2.5">
      <span class="w-1.5 h-1.5 rounded-full" style="background-color: <%= dot_color %>;"></span>
      <span class="text-sm font-medium" style="color: <%= text_color %>;"><%= label %></span>
      <span class="text-xs text-gray-500"><%= subtitle %></span>
    </div>
    <span class="text-xs text-gray-500" data-lane-count="<%= commitment %>"><%= projects.length %></span>
  </div>

  <!-- Lane body -->
  <div class="p-2.5 bg-menu space-y-2">
    <% if projects.any? %>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2"
           data-roadmap-lane="<%= commitment %>">
        <% projects.each do |project| %>
          <%= render "roadmaps/card", project: project, commitment: commitment %>
        <% end %>
      </div>
    <% else %>
      <div class="py-2 px-1 text-xs text-gray-500">No projects in this lane.</div>
    <% end %>

    <% if projects_off_roadmap.any? %>
      <%= render "roadmaps/add_to_lane",
          commitment: commitment,
          label: label,
          projects_off_roadmap: projects_off_roadmap,
          team: team %>
    <% end %>
  </div>
</div>
