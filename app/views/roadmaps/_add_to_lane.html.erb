<%# locals: (commitment:, label:, projects_off_roadmap:, team:) %>
<button type="button"
        data-action="click->roadmap-add#open"
        data-lane="<%= commitment %>"
        class="rounded-lg border border-dashed border-stroke hover:border-gray-500 transition-colors min-h-[98px] flex items-center justify-center gap-1.5 text-xs text-gray-500 hover:text-gray-300 cursor-pointer">
  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
  </svg>
  <span class="hidden sm:inline">Add project</span>
  <span class="sm:hidden">Add to <%= label %></span>
</button>
