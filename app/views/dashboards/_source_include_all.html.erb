<%# locals: (name:, value:, checked:, target:) %>
<%# "All issues" toggle on a team/project row in the group modal. Only shown while the row's source
    box is checked (via the row's group/source :has); an unchecked source's toggle is ignored server-side. %>
<label class="hidden group-has-[[data-source]:checked]/source:inline-flex items-center gap-1.5 shrink-0 px-2 py-1 rounded text-[11px] text-gray-500 hover:text-gray-300 cursor-pointer"
       title="Show every open issue here, not just the ones assigned to you">
  <%= check_box_tag name, value, checked, id: nil, class: "rounded border-stroke bg-background text-accent focus:ring-accent cursor-pointer w-3 h-3", data: { dashboard_group_form_target: target } %>
  All issues
</label>
