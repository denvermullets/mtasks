<%# locals: (dashboard:, group:, issues:, inaccessible:, filter:, mine:, today:) %>
<%# The ⋮ menu is a sibling of the <details>, not a child: anything inside <details> other than the
    summary is hidden when it collapses, <form> isn't allowed inside <summary>, and the card clips overflow. %>
<% group_url = dashboard_group_path(dashboard, group, dashboard_return_params) %>
<%# Params for the group modal's edit mode; shared by the ⋮ menu's Edit and the inaccessible-state link. %>
<% edit_params = {
     dashboard_group_form_url_param: group_url,
     dashboard_group_form_method_param: "patch",
     dashboard_group_form_title_param: "Edit group",
     dashboard_group_form_submit_param: "Save",
     dashboard_group_form_name_param: group.name,
     dashboard_group_form_description_param: group.description.to_s,
     dashboard_group_form_color_param: group.color,
     dashboard_group_form_team_ids_param: group.team_ids.to_json,
     dashboard_group_form_project_ids_param: group.project_ids.to_json,
     dashboard_group_form_delete_url_param: group_url
   } %>
<div class="relative">
  <details open
           id="<%= dom_id(group) %>"
           class="group rounded-xl border border-stroke bg-foreground overflow-hidden">
    <summary class="list-none w-full flex items-start justify-between gap-3 pl-4 pr-12 py-3 cursor-pointer select-none">
      <div class="min-w-0">
        <div class="flex items-center gap-2 min-w-0">
          <span class="w-2 h-2 rounded-full shrink-0" style="background-color: <%= group.color %>;"></span>
          <span class="text-sm font-semibold text-gray-100 truncate"><%= group.name %></span>
          <span class="text-[11px] text-gray-500 px-1.5 py-0.5 rounded bg-background border border-stroke shrink-0"><%= issues.size %></span>
        </div>
        <% if group.description.present? %>
          <p class="text-xs text-gray-500 leading-snug mt-1"><%= group.description %></p>
        <% end %>
      </div>
      <svg class="w-4 h-4 text-gray-500 shrink-0 mt-0.5 transition-transform group-open:rotate-180"
           fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
      </svg>
    </summary>

    <div class="border-t border-stroke">
      <% if inaccessible %>
        <p class="px-4 py-3 text-sm text-gray-500" data-testid="dashboard-group-inaccessible">
          This group's teams/projects are no longer available.
          <%= tag.button "Edit group",
              type: "button",
              data: edit_params.merge(action: "click->dashboard-group-form#open"),
              class: "text-accent hover:underline cursor-pointer" %>
        </p>
      <% elsif issues.empty? %>
        <p class="px-4 py-3 text-sm text-gray-500"><%= dashboard_empty_group_message(filter, mine: mine) %></p>
      <% else %>
        <div class="divide-y divide-stroke">
          <% issues.each do |issue| %>
            <%= render "dashboards/issue_row", issue: issue, today: today %>
          <% end %>
        </div>
      <% end %>
    </div>
  </details>

  <div class="absolute right-3 top-2.5" data-controller="team-menu">
    <button type="button"
            data-action="click->team-menu#toggleDropdown:stop"
            class="p-1 rounded-md text-gray-500 hover:text-gray-200 hover:bg-gray-800 cursor-pointer"
            aria-label="Group menu">
      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
        <path d="M10 6a2 2 0 110-4 2 2 0 010 4zM10 12a2 2 0 110-4 2 2 0 010 4zM10 18a2 2 0 110-4 2 2 0 010 4z"></path>
      </svg>
    </button>
    <div data-team-menu-target="dropdown"
         class="hidden absolute right-0 mt-1 w-40 bg-foreground border border-stroke rounded-md shadow-lg z-50">
      <%= tag.button "Edit",
          type: "button",
          data: edit_params.merge(action: "click->team-menu#toggleDropdown click->dashboard-group-form#open"),
          class: "block w-full text-left px-4 py-2 text-sm text-gray-300 hover:bg-hover-highlight rounded-md cursor-pointer" %>
      <%= button_to "Move up", move_dashboard_group_path(dashboard, group, dashboard_return_params),
                    method: :patch,
                    params: { direction: "up" },
                    class: "block w-full text-left px-4 py-2 text-sm text-gray-300 hover:bg-hover-highlight rounded-md cursor-pointer" %>
      <%= button_to "Move down", move_dashboard_group_path(dashboard, group, dashboard_return_params),
                    method: :patch,
                    params: { direction: "down" },
                    class: "block w-full text-left px-4 py-2 text-sm text-gray-300 hover:bg-hover-highlight rounded-md cursor-pointer" %>
      <%= button_to "Delete", group_url,
                    method: :delete,
                    form: { data: { turbo_confirm: "Delete \"#{group.name}\"? Its issues stay where they are." } },
                    class: "block w-full text-left px-4 py-2 text-sm text-red-400 hover:bg-hover-highlight rounded-md cursor-pointer" %>
    </div>
  </div>
</div>
