<%= form_with model: [issue.team, issue, comment],
             html: { class: "bg-foreground rounded-lg p-4 mb-4" },
             data: { turbo_frame: "_top", controller: "submit-on-cmd-enter file-upload" } do |form| %>
  <div class="flex items-start gap-3">
    <%= user_avatar(Current.user) %>
    <div class="flex-1 min-w-0">
      <div data-file-upload-target="dropzone"
           data-controller="issue-mention"
           data-issue-mention-search-url-value="<%= search_team_issues_path(issue.team) %>"
           data-issue-mention-team-identifier-value="<%= issue.team.identifier %>"
           data-action="dragover->file-upload#dragOver dragenter->file-upload#dragEnterZone dragleave->file-upload#dragLeaveZone drop->file-upload#dropOnZone"
           class="rounded transition-colors relative">
        <%= form.text_area :body,
            placeholder: "Leave a comment (drop files here)...",
            class: "w-full bg-transparent text-gray-300 placeholder-gray-500 focus:outline-none resize-none border-0 p-0 overflow-hidden",
            rows: 2,
            data: { controller: "auto-resize", action: "input->auto-resize#resize keydown->submit-on-cmd-enter#submit input->issue-mention#onInput keydown->issue-mention#onKeydown paste->issue-mention#onPaste", issue_mention_target: "textarea" } %>
        <%= render "issue_mentions/dropdown" %>
      </div>
      <div data-file-upload-target="fileList" class="space-y-1 mt-2"></div>
      <% if comment.errors.any? %>
        <div class="text-red-400 text-xs mt-2">
          <%= comment.errors.full_messages.join(', ') %>
        </div>
      <% end %>
    </div>
    <div class="flex items-center gap-2 ml-auto shrink-0">
      <label class="text-gray-500 hover:text-gray-400 cursor-pointer">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13"></path>
        </svg>
        <%= form.file_field :files, multiple: true,
            data: { file_upload_target: "input", action: "change->file-upload#handleFiles" },
            class: "hidden" %>
      </label>
      <button type="submit" class="text-gray-500 hover:text-gray-400 cursor-pointer">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"></path>
        </svg>
      </button>
    </div>
  </div>
<% end %>
