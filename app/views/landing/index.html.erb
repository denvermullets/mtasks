<div class="landing-page bg-background text-gray-100 min-h-screen overflow-y-auto">
  <!-- Navigation -->
  <nav class="px-4 sm:px-8 py-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-stroke">
    <div class="flex items-center gap-2">
      <%= image_tag "icon.png", alt: "JAIT Logo", class: "w-8 h-8" %>
      <span class="text-xl font-semibold">Just Another Issue Tracker</span>
    </div>
    <div class="flex items-center gap-4">
      <%= link_to "Log in", new_session_path, class: "px-3.5 py-2.5 rounded-md bg-foreground hover:bg-hover-highlight text-gray-300 font-medium transition-colors" %>
      <%= link_to "Sign up", new_user_path, class: "px-3.5 py-2.5 rounded-md border border-accent text-gray-200 hover:bg-accent hover:text-gray-800 font-medium transition-colors" %>
    </div>
  </nav>
  <!-- Hero Section -->
  <section class="px-8 py-20 max-w-7xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div>
        <h1 class="text-5xl lg:text-6xl font-bold mb-6 leading-tight">
          Track issues that matter to your team
        </h1>
        <p class="text-xl text-gray-400 mb-8">
          Powerful, self-serve issue tracking to help you organize, prioritize, and ship faster.
        </p>
        <div class="flex gap-4">
          <%= link_to "Sign up", new_user_path, class: "px-3.5 py-2.5 rounded-md border border-accent text-gray-200 hover:bg-accent hover:text-gray-800 font-medium transition-colors" %>
        </div>
      </div>
      <div class="relative">
        <%= image_tag "full-issue.png", alt: "Issue tracking interface", class: "rounded-lg shadow-2xl border border-stroke" %>
      </div>
    </div>
  </section>
  <!-- Features Section -->
  <section class="px-8 py-20 bg-foreground">
    <div class="max-w-7xl mx-auto">
      <div class="mb-16">
        <p class="text-accent font-medium mb-4">Features</p>
        <h2 class="text-4xl font-bold mb-4">Everything you need to track issues</h2>
        <p class="text-xl text-gray-400">
          Simple, powerful tools to help you manage your team's work effectively.
        </p>
      </div>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
        <div class="space-y-8">
          <div class="border-l-4 border-accent pl-6">
            <h3 class="text-2xl font-bold mb-3">Keyboard-first workflow</h3>
            <p class="text-gray-400 mb-4">
              Speed through your work with keyboard shortcuts. Press Cmd+K to see all available shortcuts for quick navigation and actions.
            </p>
          </div>
          <div class="pl-6">
            <h3 class="text-2xl font-bold mb-3">Flexible views</h3>
            <p class="text-gray-400 mb-4">
              Switch between Kanban boards and list views. Group issues by status, assignee, project, priority, label, or milestone.
            </p>
          </div>
          <div class="pl-6">
            <h3 class="text-2xl font-bold mb-3">GitHub integration</h3>
            <p class="text-gray-400 mb-4">
              Connect your repositories and link pull requests directly to issues. Track PR status without leaving your board.
            </p>
          </div>
        </div>
        <div class="relative">
          <%= image_tag "board.png", alt: "Kanban board view", class: "rounded-lg shadow-2xl border border-stroke" %>
        </div>
      </div>
    </div>
  </section>
  <!-- More Features Section -->
  <section class="px-8 py-20">
    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <div class="bg-foreground border border-stroke rounded-lg p-6">
          <h3 class="text-xl font-bold mb-3">Milestones</h3>
          <p class="text-gray-400">
            Plan releases and sprints with milestones. Track progress with visual indicators and due dates.
          </p>
        </div>
        <div class="bg-foreground border border-stroke rounded-lg p-6">
          <h3 class="text-xl font-bold mb-3">Labels & Projects</h3>
          <p class="text-gray-400">
            Organize with color-coded labels and group related work into projects for better visibility.
          </p>
        </div>
        <div class="bg-foreground border border-stroke rounded-lg p-6">
          <h3 class="text-xl font-bold mb-3">Sub-issues</h3>
          <p class="text-gray-400">
            Break down complex work into smaller tasks with parent-child issue relationships.
          </p>
        </div>
        <div class="bg-foreground border border-stroke rounded-lg p-6">
          <h3 class="text-xl font-bold mb-3">Team collaboration</h3>
          <p class="text-gray-400">
            Assign issues, add comments, and keep everyone in sync with real-time updates.
          </p>
        </div>
        <div class="bg-foreground border border-stroke rounded-lg p-6">
          <h3 class="text-xl font-bold mb-3">Custom lanes</h3>
          <p class="text-gray-400">
            Create custom status columns with colors to match your team's workflow.
          </p>
        </div>
        <div class="bg-foreground border border-stroke rounded-lg p-6">
          <h3 class="text-xl font-bold mb-3">CSV import</h3>
          <p class="text-gray-400">
            Migrate from other tools easily by importing your existing issues via CSV.
          </p>
        </div>
      </div>
    </div>
  </section>
  <!-- Stats Section -->
  <section class="px-8 py-20">
    <div class="max-w-7xl mx-auto">
      <h2 class="text-4xl font-bold text-center mb-16">Built for teams of all sizes</h2>
      <div class="bg-foreground border border-stroke rounded-2xl p-12">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
          <div class="text-center">
            <div class="text-6xl font-bold mb-2">Fast</div>
            <p class="text-gray-400">Lightning quick</p>
          </div>
          <div class="text-center">
            <div class="text-6xl font-bold mb-2">Simple</div>
            <p class="text-gray-400">Easy to use</p>
          </div>
          <div class="text-center">
            <div class="text-6xl font-bold mb-2">Free</div>
            <p class="text-gray-400">To get started</p>
          </div>
        </div>
      </div>
    </div>
  </section>
  <!-- CTA Section -->
  <section class="px-8 py-20 bg-foreground">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-4xl font-bold mb-6">Start tracking issues today</h2>
      <p class="text-xl text-gray-400 mb-8">
        Get started in seconds. No credit card required.
      </p>
      <div class="flex gap-4 justify-center">
        <%= link_to "Get started", new_user_path, class: "px-3.5 py-2.5 rounded-md border border-accent text-gray-200 hover:bg-accent hover:text-gray-800 font-medium transition-colors" %>
      </div>
    </div>
  </section>
  <!-- Footer -->
  <footer class="px-8 py-12 border-t border-stroke">
    <div class="max-w-7xl mx-auto">
      <div class="flex items-center gap-2 mb-8">
        <%= image_tag "icon.png", alt: "JAIT Logo", class: "w-8 h-8" %>
        <span class="text-xl font-semibold">Just Another Issue Tracker</span>
      </div>
      <div class="text-gray-400 text-sm">
        A simple issue tracker for your team.
      </div>
    </div>
  </footer>
</div>
