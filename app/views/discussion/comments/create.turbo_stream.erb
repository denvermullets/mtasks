<% if @comment.persisted? %>
  <%= turbo_stream.replace "discussion_composer", partial: "discussion/comments/composer",
                                                  locals: { project: @project, team: @project.team } %>
<% else %>
  <%= turbo_stream.replace "discussion_composer", partial: "discussion/comments/composer",
                                                  locals: { project: @project, team: @project.team, comment: @comment } %>
<% end %>

<% if @comment.persisted? && push_result %>
  <% if push_result.success? %>
    <%= turbo_stream.update "discussion-flash" do %>
      <%= render "shared/flash", message: "Comment posted. Posted to ##{push_result.channel_name}.", type: "notice" %>
    <% end %>
  <% else %>
    <%= turbo_stream.update "discussion-flash" do %>
      <%= render "shared/flash", message: "Comment saved, but chat push failed: #{push_result.error}", type: "alert" %>
    <% end %>
  <% end %>
<% end %>
