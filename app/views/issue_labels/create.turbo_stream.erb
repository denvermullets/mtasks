<%# Update the issue card in board view %>
<%= turbo_stream.replace "issue_#{@issue.id}", partial: "issues/issue_card", locals: { issue: @issue, visible_properties: @visible_properties, labels: @labels } %>

<%# Update the list row in list view %>
<%= turbo_stream.replace "issue_row_#{@issue.id}", partial: "issues/list_row", locals: { issue: @issue, display_options: { visible_properties: @visible_properties }, labels: @labels } %>

<%# Update the sidebar if it's open %>
<%= turbo_stream.replace "issue_sidebar", partial: "issues/sidebar", locals: {
  issue: @issue,
  lanes: @lanes,
  team_members: @team_members,
  projects: @projects,
  labels: @labels,
  milestones: @milestones
} %>
