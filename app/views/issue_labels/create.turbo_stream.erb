<%# Update the issue card on the board %>
<%= turbo_stream.replace "issue_#{@issue.id}", partial: "issues/issue_card", locals: { issue: @issue, visible_properties: @visible_properties } %>

<%# Update the sidebar if it's open %>
<%= turbo_stream.replace "issue_sidebar", partial: "issues/sidebar", locals: {
  issue: @issue,
  lanes: @lanes,
  team_members: @team_members,
  projects: @projects,
  labels: @labels,
  milestones: @milestones
} %>
